<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Worker Accounts | DiEtalase</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #fff8f5; color: #4a3728; }
        .bg-earthy { background-color: #6f4627; }
        .text-earthy { color: #6f4627; }
        .border-earthy { border-color: #6f4627; }
    </style>
</head>
<body class="flex bg-[#fff8f5]">
    <%- include('partials/admin_sidebar') %>

    <!-- Main Content Area -->
    <main class="flex-grow ml-80 p-12 min-h-screen">
        <div class="max-w-[1200px] mx-auto">
            
            <div class="flex justify-between items-center mb-12">
                <div>
                    <h1 class="text-4xl font-bold text-earthy tracking-tight">Worker Management</h1>
                    <p class="text-gray-500 mt-2">Manage Field Admin accounts and monitor their activity.</p>
                </div>
                <button onclick="openModal('addWorkerModal')" class="bg-earthy text-white px-8 py-4 rounded-2xl font-bold hover:bg-[#5a3820] transition-all shadow-lg flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    New Worker
                </button>
            </div>

            <!-- Data Table -->
            <div class="bg-white rounded-[32px] p-8 shadow-sm border border-orange-50 mb-12">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-gray-400 text-sm tracking-wider uppercase border-b border-orange-50">
                            <th class="pb-4 font-semibold">ID</th>
                            <th class="pb-4 font-semibold">Username</th>
                            <th class="pb-4 font-semibold">Nickname</th>
                            <th class="pb-4 font-semibold">Added On</th>
                            <th class="pb-4 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% workers.forEach(worker => { %>
                        <tr class="border-b border-gray-50 hover:bg-orange-50/30 transition-colors group">
                            <td class="py-4 font-bold text-gray-400">#<%= worker.id %></td>
                            <td class="py-4 font-bold text-earthy"><%= worker.username %></td>
                            <td class="py-4 font-semibold"><%= worker.nickname || '-' %></td>
                            <td class="py-4 text-sm text-gray-500"><%= new Date(worker.created_at).toLocaleDateString() %></td>
                            <td class="py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <button onclick="viewLogs(<%= worker.id %>, '<%= worker.nickname || worker.username %>')" class="px-4 py-2 bg-blue-50 text-blue-600 rounded-xl text-sm font-bold hover:bg-blue-100 transition-colors shadow-sm">Logs</button>
                                    <button onclick="openResetModal(<%= worker.id %>)" class="px-4 py-2 bg-orange-50 text-orange-600 rounded-xl text-sm font-bold hover:bg-orange-100 transition-colors shadow-sm">Reset Pwd</button>
                                    <button onclick="deleteWorker(<%= worker.id %>)" class="px-4 py-2 bg-red-50 text-red-600 rounded-xl text-sm font-bold hover:bg-red-100 transition-colors shadow-sm">Delete</button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                        <% if(workers.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center py-8 text-gray-400">No worker accounts found.</td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            
        </div>
    </main>

    <!-- Modals -->
    <!-- Add Worker Modal -->
    <div id="addWorkerModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
        <div class="bg-white p-8 rounded-[32px] w-[400px]">
            <h3 class="text-2xl font-bold text-earthy mb-6">New Worker</h3>
            <form id="addWorkerForm" onsubmit="addWorker(event)">
                <div class="mb-4">
                    <label class="block text-sm font-bold text-gray-500 mb-2">Username</label>
                    <input type="text" id="add_username" required class="w-full p-3 bg-gray-50 rounded-xl border border-gray-200">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-bold text-gray-500 mb-2">Nickname</label>
                    <input type="text" id="add_nickname" required class="w-full p-3 bg-gray-50 rounded-xl border border-gray-200">
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-bold text-gray-500 mb-2">Password</label>
                    <input type="password" id="add_password" required class="w-full p-3 bg-gray-50 rounded-xl border border-gray-200">
                </div>
                <div class="flex gap-4">
                    <button type="button" onclick="closeModal('addWorkerModal')" class="flex-1 p-3 text-gray-500 font-bold hover:bg-gray-100 rounded-xl">Cancel</button>
                    <button type="submit" class="flex-1 p-3 bg-earthy text-white font-bold rounded-xl hover:bg-[#5a3820]">Create</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Reset Password Modal -->
    <div id="resetModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
        <div class="bg-white p-8 rounded-[32px] w-[400px]">
            <h3 class="text-2xl font-bold text-earthy mb-6">Reset Password</h3>
            <form id="resetForm" onsubmit="resetPassword(event)">
                <input type="hidden" id="reset_worker_id">
                <div class="mb-6">
                    <label class="block text-sm font-bold text-gray-500 mb-2">New Password</label>
                    <input type="password" id="reset_password" required class="w-full p-3 bg-gray-50 rounded-xl border border-gray-200">
                </div>
                <div class="flex gap-4">
                    <button type="button" onclick="closeModal('resetModal')" class="flex-1 p-3 text-gray-500 font-bold hover:bg-gray-100 rounded-xl">Cancel</button>
                    <button type="submit" class="flex-1 p-3 bg-orange-500 text-white font-bold rounded-xl hover:bg-orange-600">Save</button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Logs Modal -->
    <div id="logsModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
        <div class="bg-white p-8 rounded-[32px] w-[800px] max-h-[80vh] flex flex-col">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-bold text-earthy" id="logsTitle">Activity Logs</h3>
                <button onclick="closeModal('logsModal')" class="text-gray-400 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="flex-grow overflow-y-auto pr-2" id="logsContainer">
                <p class="text-center text-gray-400">Loading...</p>
            </div>
        </div>
    </div>

    <script>
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
            document.getElementById(id).classList.add('flex');
        }
        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            document.getElementById(id).classList.remove('flex');
        }

        async function addWorker(e) {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true; btn.innerText = "Creating...";
            
            try {
                const res = await fetch('/admin/api/workers/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        username: document.getElementById('add_username').value,
                        nickname: document.getElementById('add_nickname').value,
                        password: document.getElementById('add_password').value
                    })
                });
                const data = await res.json();
                if(data.success) location.reload();
                else alert(data.message);
            } catch(err) { alert("Error"); }
            btn.disabled = false; btn.innerText = "Create";
        }

        function openResetModal(id) {
            document.getElementById('reset_worker_id').value = id;
            document.getElementById('reset_password').value = '';
            openModal('resetModal');
        }

        async function resetPassword(e) {
            e.preventDefault();
            const id = document.getElementById('reset_worker_id').value;
            const pwd = document.getElementById('reset_password').value;
            try {
                const res = await fetch(`/admin/api/workers/${id}/reset`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: pwd })
                });
                const data = await res.json();
                if(data.success) {
                    alert('Password updated successfully');
                    closeModal('resetModal');
                } else alert(data.message);
            } catch(err) { alert("Error"); }
        }

        async function deleteWorker(id) {
            if(!confirm("Are you sure you want to delete this worker account?")) return;
            try {
                const res = await fetch(`/admin/api/workers/${id}/delete`, { method: 'DELETE' });
                const data = await res.json();
                if(data.success) location.reload();
                else alert(data.message);
            } catch(err) { alert("Error"); }
        }

        async function viewLogs(id, name) {
            document.getElementById('logsTitle').innerText = `Activity Logs: ${name}`;
            document.getElementById('logsContainer').innerHTML = '<p class="text-center text-gray-400 py-8">Loading...</p>';
            openModal('logsModal');

            try {
                const res = await fetch(`/admin/api/workers/${id}/logs`);
                const data = await res.json();
                
                if(!data.success) {
                    document.getElementById('logsContainer').innerHTML = '<p class="text-center text-red-400 py-8">Failed to load logs</p>';
                    return;
                }
                
                if(data.logs.length === 0) {
                    document.getElementById('logsContainer').innerHTML = '<p class="text-center text-gray-400 py-8">No activity recorded yet.</p>';
                    return;
                }
                
                let html = '<div class="space-y-4">';
                data.logs.forEach(log => {
                    html += `
                    <div class="bg-gray-50 p-4 rounded-2xl flex justify-between items-center">
                        <div>
                            <p class="font-bold text-earthy">${log.action}</p>
                            <p class="text-sm text-gray-500">${log.target_name || 'N/A'}</p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs font-bold text-gray-400">${new Date(log.created_at).toLocaleString()}</p>
                        </div>
                    </div>
                    `;
                });
                html += '</div>';
                document.getElementById('logsContainer').innerHTML = html;
            } catch(err) {
                document.getElementById('logsContainer').innerHTML = '<p class="text-center text-red-400 py-8">Error loading logs</p>';
            }
        }
    </script>
</body>
</html>
