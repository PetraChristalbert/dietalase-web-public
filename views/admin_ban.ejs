<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Threat Mitigation | Pusat Pemblokiran IP</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #0b0a0a; color: #f5f5f7; }
        .cyber-grid { background-image: linear-gradient(to right, #8080800d 1px, transparent 1px), linear-gradient(to bottom, #8080800d 1px, transparent 1px); background-size: 32px 32px; }
        .neon-card { border: 1px solid rgba(239, 68, 68, 0.2); background: rgba(18, 17, 17, 0.85); backdrop-filter: blur(20px); }
        .glow-neon { box-shadow: 0 0 40px rgba(239, 68, 68, 0.1); }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6 relative overflow-x-hidden cyber-grid">
    <!-- Ambient Red Background Glows -->
    <div class="absolute w-[500px] h-[500px] rounded-full bg-red-900/10 blur-[150px] -top-52 -left-52 z-0"></div>
    <div class="absolute w-[500px] h-[500px] rounded-full bg-orange-900/5 blur-[150px] -bottom-52 -right-52 z-0"></div>

    <div class="relative max-w-2xl w-full neon-card rounded-[40px] p-10 md:p-12 z-10 glow-neon">
        <!-- Shield and Crosshair Indicator -->
        <div class="flex items-center gap-6 mb-10 pb-8 border-b border-neutral-800/60">
            <div class="w-16 h-16 bg-red-950/50 border border-red-500/30 rounded-2xl flex items-center justify-center text-red-500 shadow-inner">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
            </div>
            <div>
                <span class="text-[10px] uppercase tracking-[0.2em] font-extrabold text-red-500">Pusat Mitigasi Ancaman</span>
                <h1 class="text-2xl font-black tracking-tight text-white mt-1">Blokir Permanen IP Pengunjung</h1>
            </div>
        </div>

        <p class="text-neutral-400 font-light text-sm leading-relaxed mb-8">
            Sistem mendeteksi aktivitas mencurigakan berupa kegagalan masuk (sandi/OTP) sebanyak 3 kali dari asal akses di bawah ini. Harap tinjau detail telemetry sebelum memblokir permanen.
        </p>

        <!-- Intruder Metadata grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
            <div class="bg-neutral-950/40 border border-neutral-800/40 p-5 rounded-2xl flex flex-col justify-between">
                <span class="text-[10px] uppercase font-bold text-neutral-500 tracking-wider">Alamat IP</span>
                <span class="text-lg font-bold text-white mt-1 font-mono"><%= ip %></span>
            </div>
            <div class="bg-neutral-950/40 border border-neutral-800/40 p-5 rounded-2xl flex flex-col justify-between">
                <span class="text-[10px] uppercase font-bold text-neutral-500 tracking-wider">Perkiraan Lokasi</span>
                <span class="text-lg font-bold text-red-400 mt-1"><%= location %></span>
            </div>
            <div class="bg-neutral-950/40 border border-neutral-800/40 p-5 rounded-2xl flex flex-col justify-between col-span-1 md:col-span-2">
                <span class="text-[10px] uppercase font-bold text-neutral-500 tracking-wider">Browser & Sistem Operasi</span>
                <span class="text-sm font-semibold text-neutral-300 mt-1 leading-relaxed">
                    <%= os %> • <%= browser %>
                </span>
            </div>
            <div class="bg-neutral-950/40 border border-neutral-800/40 p-5 rounded-2xl flex flex-col justify-between">
                <span class="text-[10px] uppercase font-bold text-neutral-500 tracking-wider">Resolusi Layar</span>
                <span class="text-sm font-semibold text-neutral-300 mt-1 font-mono"><%= screen %></span>
            </div>
            <div class="bg-neutral-950/40 border border-neutral-800/40 p-5 rounded-2xl flex flex-col justify-between">
                <span class="text-[10px] uppercase font-bold text-neutral-500 tracking-wider">Waktu Aktivitas</span>
                <span class="text-sm font-semibold text-neutral-300 mt-1"><%= time %></span>
            </div>
        </div>

        <!-- Mitigation Trigger form -->
        <form action="/admin/secure/ban-visitor" method="POST" class="space-y-4">
            <input type="hidden" name="token" value="<%= token %>">
            <input type="hidden" name="ip" value="<%= ip %>">
            
            <button type="submit" class="w-full py-5 bg-gradient-to-r from-red-700 to-red-500 hover:from-red-600 hover:to-red-400 text-white font-extrabold text-lg rounded-2xl shadow-xl shadow-red-950/50 hover:shadow-red-900/60 transform active:scale-[0.98] transition-all flex items-center justify-center gap-3">
                <svg class="w-5 h-5 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                </svg>
                BLOKIR PERMANEN IP INI
            </button>
            
            <a href="/admin/login" class="block text-center text-xs font-bold text-neutral-500 hover:text-neutral-300 transition-colors py-2 uppercase tracking-widest mt-2">
                Batalkan & Kembali Ke Login
            </a>
        </form>
    </div>
</body>
</html>
