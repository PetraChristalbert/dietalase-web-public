<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #fff8f5; color: #4a3728; }
        .bg-earthy { background-color: #6f4627; }
        .text-earthy { color: #6f4627; }
        .border-earthy { border-color: #6f4627; }
    </style>
</head>
<body class="flex bg-[#fff8f5]">
    <%- include('partials/admin_sidebar') %>

    <!-- Main Content Area -->
    <main class="flex-grow ml-80 p-12 min-h-screen">
        <div class="max-w-[1400px] mx-auto">
            
            <!-- Header -->
            <div class="mb-12">
                <h1 class="text-4xl font-bold text-earthy tracking-tight">Community Reports</h1>
                <p class="text-gray-500 mt-2">Manage user feedback and flag illegal or inappropriate content.</p>
            </div>

            <!-- Reports Table -->
            <div class="bg-white rounded-[32px] overflow-hidden shadow-sm border border-orange-50">
                <table class="w-full text-left">
                    <thead class="bg-orange-50/50">
                        <tr>
                            <th class="px-8 py-6 text-xs font-bold text-earthy uppercase tracking-widest">Reporter</th>
                            <th class="px-8 py-6 text-xs font-bold text-earthy uppercase tracking-widest">Target</th>
                            <th class="px-8 py-6 text-xs font-bold text-earthy uppercase tracking-widest">Reason</th>
                            <th class="px-8 py-6 text-xs font-bold text-earthy uppercase tracking-widest">Date</th>
                            <th class="px-8 py-6 text-xs font-bold text-earthy uppercase tracking-widest">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-orange-50">
                        <% reports.forEach(report => { %>
                            <tr id="report-<%= report.rid %>" class="hover:bg-orange-50/20 transition-colors">
                                <td class="px-8 py-6">
                                    <p class="font-bold text-earthy"><%= report.reporter_name || 'Anonymous' %></p>
                                    <p class="text-xs text-gray-400">ID: <%= report.reporter_eid %></p>
                                </td>
                                <td class="px-8 py-6">
                                    <% if (report.target_pid) { %>
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                            </div>
                                            <div>
                                                <p class="text-sm font-bold text-earthy"><%= report.product_name %></p>
                                                <p class="text-[10px] text-gray-400 uppercase font-bold">Product</p>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                            </div>
                                            <div>
                                                <p class="text-sm font-bold text-earthy"><%= report.store_name %></p>
                                                <p class="text-[10px] text-gray-400 uppercase font-bold">Store</p>
                                            </div>
                                        </div>
                                    <% } %>
                                </td>
                                <td class="px-8 py-6">
                                    <div class="max-w-xs">
                                        <p class="text-sm text-gray-600 italic">"<%= report.reason %>"</p>
                                    </div>
                                </td>
                                <td class="px-8 py-6">
                                    <p class="text-sm text-gray-400"><%= new Date(report.created_at).toLocaleDateString() %></p>
                                </td>
                                <td class="px-8 py-6">
                                    <div class="flex gap-2">
                                        <button onclick="resolveReport('<%= report.rid %>', 'resolved')" class="bg-earthy text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-green-700 transition-all">Resolve</button>
                                        <button onclick="resolveReport('<%= report.rid %>', 'dismissed')" class="bg-gray-100 text-gray-400 px-4 py-2 rounded-lg text-xs font-bold hover:bg-gray-200 transition-all">Dismiss</button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        </div>
    </main>

    <script>
        async function resolveReport(rid, action) {
            try {
                const response = await fetch(`/admin/reports/resolve/${rid}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: action })
                });
                
                if (response.ok) {
                    document.getElementById(`report-${rid}`).remove();
                } else {
                    alert('Action failed');
                }
            } catch (error) {
                alert('Connection error');
            }
        }
    </script>
</body>
</html>
