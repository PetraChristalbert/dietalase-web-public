    <div id="languageSelectorWrapper" class="fixed bottom-0 right-4 md:right-8 z-50 w-[120px] rounded-t-xl overflow-hidden shadow-[0_-4px_20px_rgba(0,0,0,0.2)] bg-[#5c3a20] border border-[#4a2e19] border-b-0 pointer-events-auto">
      <!-- Expanding Drop-up Panel -->
      <div id="languageOptionsPanel" class="w-full bg-[#5c3a20] flex flex-col justify-end" style="max-height: 0px; transition: max-height 0.3s ease-in-out;">
        <div class="flex flex-col w-full text-sm font-medium text-[#ffe3d1]">
          <button onclick="window.location.href='/change-language/en?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search)" class="flex items-center gap-3 px-4 py-3 bg-[#6f4627] hover:bg-[#6f4627] transition-colors w-full text-left border-b border-[#4a2e19] outline-none cursor-pointer text-[#ffe3d1]">
            <span class="text-lg leading-none">🇬🇧</span>
            <span>EN</span>
          </button>
          <button onclick="window.location.href='/change-language/id?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search)" class="flex items-center gap-3 px-4 py-3 bg-[#5c3a20] hover:bg-[#6f4627] transition-colors w-full text-left border-b border-[#4a2e19] outline-none cursor-pointer text-[#ffe3d1]">
            <span class="text-lg leading-none">🇮🇩</span>
            <span>ID</span>
          </button>
          <button onclick="window.location.href='/change-language/jp?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search)" class="flex items-center gap-3 px-4 py-3 bg-[#5c3a20] hover:bg-[#6f4627] transition-colors w-full text-left border-b border-[#4a2e19] outline-none cursor-pointer text-[#ffe3d1]">
            <span class="text-lg leading-none">🇯🇵</span>
            <span>JP</span>
          </button>
          <button onclick="window.location.href='/change-language/ph?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search)" class="flex items-center gap-3 px-4 py-3 bg-[#5c3a20] hover:bg-[#6f4627] transition-colors w-full text-left border-b border-[#4a2e19] outline-none cursor-pointer text-[#ffe3d1]">
            <span class="text-lg leading-none">🇵🇭</span>
            <span>PH</span>
          </button>
        </div>
      </div>
      <!-- Trigger Button -->
      <%
        const loc = (typeof getLocale === 'function') ? getLocale() : 'en';
        const flagMap = { en: '🇬🇧', id: '🇮🇩', jp: '🇯🇵', ph: '🇵🇭' };
      %>
      <button id="languageSelectorBtn" class="flex items-center justify-between w-full bg-[#5c3a20] hover:bg-[#6f4627] transition-colors px-4 py-3 pointer-events-auto border-none outline-none cursor-pointer" style="color: #ffe3d1;">
        <div class="flex items-center gap-2 font-bold text-sm">
          <span class="text-lg leading-none"><%= flagMap[loc] || '🇬🇧' %></span>
          <span><%= loc.toUpperCase() %></span>
        </div>
        <svg id="languageSelectorIcon" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
      </button>
    </div>
  <script src="/javascripts/jquery-3.6.0.min.js"></script>
  
