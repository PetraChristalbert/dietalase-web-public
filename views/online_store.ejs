    <script>
      const mobileMenuBtn = document.getElementById('mobileMenuBtn');
      const desktopMenuBtn = document.getElementById('desktopMenuBtn');
      const mobileMenuGrid = document.getElementById('mobileMenuGrid');
      const mobileMenuLinks = document.getElementById('mobileMenuLinks');
      const mobileMenuIcon = document.getElementById('mobileMenuIcon');
      const desktopMenuIcon = document.getElementById('desktopMenuIcon');
      
      let isMobileMenuOpen = false;

      function closeMobileMenu() {
        isMobileMenuOpen = false;
        if (mobileMenuGrid) mobileMenuGrid.style.maxHeight = '0px';
        if (mobileMenuLinks) {
          mobileMenuLinks.classList.add('opacity-0');
          mobileMenuLinks.classList.remove('opacity-100');
        }
        if (mobileMenuIcon) mobileMenuIcon.style.transform = 'rotate(0deg)';
        if (desktopMenuIcon) desktopMenuIcon.style.transform = 'rotate(0deg)';
      }

      function openMobileMenu() {
        isMobileMenuOpen = true;
        if (mobileMenuGrid) mobileMenuGrid.style.maxHeight = '500px';
        if (mobileMenuLinks) {
          mobileMenuLinks.classList.remove('opacity-0');
          mobileMenuLinks.classList.add('opacity-100');
        }
        if (mobileMenuIcon) mobileMenuIcon.style.transform = 'rotate(180deg)';
        if (desktopMenuIcon) desktopMenuIcon.style.transform = 'rotate(180deg)';
      }

      if (mobileMenuBtn) {
        mobileMenuBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (isMobileMenuOpen) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
        });
      }
      
      if (desktopMenuBtn) {
        desktopMenuBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (isMobileMenuOpen) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
        });
      }
    </script>
    
    <script>
      // Filter Panel Toggle Logic
      const filterToggle = document.getElementById('os-filter-toggle');
      const sidebarTrack = document.getElementById('os-sidebar-track');
      const iconTune = filterToggle.querySelector('.filter-icon-tune');
      const iconClose = filterToggle.querySelector('.filter-icon-close');
      
      let isFilterOpen = false;
      
      filterToggle.addEventListener('click', () => {
        isFilterOpen = !isFilterOpen;
        const sidebarParent = document.getElementById('os-sidebar');
        
        // Toggle Animation Class
        if (isFilterOpen) {
          sidebarTrack.classList.add('is-filtering');
          sidebarParent.classList.add('is-filtering');
          iconTune.style.display = 'none';
          iconClose.style.display = 'block';
          filterToggle.style.transform = 'scale(0.9)';
          setTimeout(() => filterToggle.style.transform = 'scale(1)', 150);
        } else {
          sidebarTrack.classList.remove('is-filtering');
          sidebarParent.classList.remove('is-filtering');
          iconTune.style.display = 'block';
          iconClose.style.display = 'none';
          filterToggle.style.transform = 'scale(0.9)';
          setTimeout(() => filterToggle.style.transform = 'scale(1)', 150);
          
          if (typeof window.executeSearch === 'function') {
            const currentKeyword = document.getElementById("os-search-input").value.trim();
            if (currentKeyword !== "") {
              window.executeSearch(currentKeyword);
            }
          }
        }
      });
      
      // Helper to trigger search
      function triggerSearch() {
          if (typeof window.executeSearch === 'function') {
            const currentKeyword = document.getElementById("os-search-input").value.trim();
            if (currentKeyword !== "") {
              window.executeSearch(currentKeyword);
            }
          }
      }

      // Simple Chip Selection Logic
      document.querySelectorAll('.os-chip-group').forEach(group => {
        const chips = group.querySelectorAll('.os-chip');
        chips.forEach(chip => {
          chip.addEventListener('click', () => {
            // Scope chips are handled separately below
            if (group.id === 'scope-chips') return; 

            chips.forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            
            if (group.id === 'category-chips') {
              window.currentCategory = chip.textContent.trim();
            } else if (group.id === 'sort-chips') {
              window.currentSort = chip.textContent.trim();
            }
            triggerSearch();
          });
        });
      });

      // Radius Slider & Scope Logic
      const scopeChips = document.querySelectorAll('#scope-chips .os-chip');
      const radiusSection = document.getElementById('radius-section');
      const radiusSlider = document.getElementById('radius-slider');
      const radiusLabel = document.getElementById('radius-label');

      // Update label when slider moves
      radiusSlider.addEventListener('input', (e) => {
        radiusLabel.textContent = `Jarak Maksimum: ${e.target.value} KM`;
      });
      // Trigger search when slider is released
      radiusSlider.addEventListener('change', (e) => {
        window.currentRadius = parseInt(e.target.value, 10);
        triggerSearch();
      });

      // Hide/Show radius based on scope
      const premiumModal = document.getElementById('premium-modal');
      
      window.closePremiumModal = function() {
        premiumModal.classList.remove('active');
      };

      scopeChips.forEach(chip => {
        chip.addEventListener('click', () => {
          if (chip.dataset.scope === 'all') {
            // Trigger Premium Popup instead of changing selection
            premiumModal.classList.add('active');
          } else {
            // It's local, just ensure active state
            scopeChips.forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            radiusSection.style.display = 'flex';
            setTimeout(() => radiusSection.style.opacity = '1', 10);
            
            window.currentScope = chip.textContent.trim();
            triggerSearch();
          }
        });
      });

      // Open Now Switch
      const openNowSwitch = document.getElementById('open-now-switch');
      if (openNowSwitch) {
        openNowSwitch.addEventListener('change', (e) => {
          window.isOpenNow = e.target.checked;
          triggerSearch();
        });
      }

      // Price Inputs
      let priceTimeout;
      const handlePriceChange = () => {
        clearTimeout(priceTimeout);
        priceTimeout = setTimeout(() => {
          const minP = document.getElementById('price-min');
          const maxP = document.getElementById('price-max');
          if (minP) window.currentMinPrice = minP.value.trim();
          if (maxP) window.currentMaxPrice = maxP.value.trim();
          triggerSearch();
        }, 800); // 800ms debounce
      };
      
      const pMin = document.getElementById('price-min');
      const pMax = document.getElementById('price-max');
      if (pMin) pMin.addEventListener('input', handlePriceChange);
      if (pMax) pMax.addEventListener('input', handlePriceChange);
      
      // Store Tabs Logic
      const storeTabs = document.querySelectorAll('#store-tabs .os-sc-tab');
      const storePanes = document.querySelectorAll('#store-tab-content .os-sc-tab-pane');
      
      storeTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          storeTabs.forEach(t => t.classList.remove('active'));
          storePanes.forEach(p => p.classList.remove('active'));
          
          tab.classList.add('active');
          const targetId = tab.getAttribute('data-target');
          document.getElementById(targetId).classList.add('active');
        });
      });

      // Product Carousel Logic
      const carouselTrack = document.getElementById('product-carousel');
      const carouselIndicator = document.getElementById('product-indicator');
      if (carouselTrack && carouselIndicator) {
        
        const updateIndicator = () => {
          const scrollLeft = carouselTrack.scrollLeft;
          const width = carouselTrack.clientWidth;
          const currentIndex = Math.round(scrollLeft / width);
          const totalSlides = carouselTrack.children.length;
          carouselIndicator.textContent = `${currentIndex + 1}/${totalSlides}`;
        };
        
        carouselTrack.addEventListener('scroll', updateIndicator);
        
        // Robust Pointer Drag Logic
        let isDragging = false;
        let startX;
        let startScrollLeft;

        carouselTrack.addEventListener('mousedown', (e) => {
          isDragging = true;
          carouselTrack.classList.add('grabbing');
          startX = e.pageX - carouselTrack.offsetLeft;
          startScrollLeft = carouselTrack.scrollLeft;
        });

        const stopDragging = () => {
          if (!isDragging) return;
          isDragging = false;
          carouselTrack.classList.remove('grabbing');
          
          // Custom snap logic to ensure it snaps to the closest image after a drag
          const width = carouselTrack.clientWidth;
          const scrollLeft = carouselTrack.scrollLeft;
          const targetIndex = Math.round(scrollLeft / width);
          carouselTrack.scrollTo({
            left: targetIndex * width,
            behavior: 'smooth'
          });
        };

        carouselTrack.addEventListener('mouseleave', stopDragging);
        carouselTrack.addEventListener('mouseup', stopDragging);

        carouselTrack.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          e.preventDefault();
          const x = e.pageX - carouselTrack.offsetLeft;
          const walk = (x - startX) * 1.5; // Drag sensitivity
          carouselTrack.scrollLeft = startScrollLeft - walk;
        });
      }
      
      // Bookmark Toggle Logic
      function setupBookmarkToggle(elementId) {
        const btn = document.getElementById(elementId);
        if (!btn) return;
        const icon = btn.querySelector('.bookmark-icon');
        let isBookmarked = false;
        
        btn.addEventListener('click', () => {
          isBookmarked = !isBookmarked;
          if (isBookmarked) {
            icon.setAttribute('fill', 'var(--primary)');
            btn.style.transform = 'scale(1.1)';
            setTimeout(() => btn.style.transform = 'scale(1)', 150);
          } else {
            icon.setAttribute('fill', 'none');
            btn.style.transform = 'scale(0.9)';
            setTimeout(() => btn.style.transform = 'scale(1)', 150);
          }
        });
        
        // Add smooth scaling to the container
        btn.style.transition = 'transform 0.15s ease-in-out';
      }
      
      setupBookmarkToggle('prod-bookmark');
      setupBookmarkToggle('store-bookmark');
    </script>
