<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #FAFAFA; color: #4a3728; }
        .bg-earthy { background-color: #4A3022; }
        .text-earthy { color: #4A3022; }
        .border-earthy { border-color: #4A3022; }
        
        /* Modern Glassmorphism Utilities */
        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 10px 40px -10px rgba(0,0,0,0.05);
        }
        
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="flex">
    <%- include('partials/admin_sidebar') %>

    <!-- Main Content Area -->
    <main class="flex-grow ml-80 p-8 lg:p-12 min-h-screen relative overflow-hidden">
        
        <!-- Abstract Background Orbs -->
        <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-orange-300/20 rounded-full blur-[100px] pointer-events-none"></div>
        <div class="absolute bottom-[-10%] left-[10%] w-[600px] h-[600px] bg-amber-200/20 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-[1600px] mx-auto relative z-10">
            
            <!-- Welcome Banner & Quick Actions -->
            <div class="glass-panel p-8 rounded-[35px] mb-10 flex flex-col xl:flex-row justify-between items-center gap-6">
                <div>
                    <h1 class="text-4xl font-bold text-earthy tracking-tight">Atelier Command Center</h1>
                    <p class="text-gray-500 mt-2 font-medium">Welcome back, <%= user.name %>. Today is <%= new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) %>.</p>
                </div>
                <div class="flex flex-wrap gap-4">
                    <a href="/admin/verification" class="px-6 py-3.5 bg-white border border-gray-100 text-gray-700 font-bold rounded-2xl hover:bg-orange-50 hover:text-earthy hover:border-orange-200 transition-all shadow-sm flex items-center gap-2">
                        <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                        Review Pending
                        <% if (metrics.pendingStores > 0) { %>
                            <span class="bg-orange-100 text-orange-600 px-2 py-0.5 rounded-lg text-xs ml-2"><%= metrics.pendingStores %></span>
                        <% } %>
                    </a>
                    <a href="/admin/transactions" class="px-6 py-3.5 bg-white border border-gray-100 text-gray-700 font-bold rounded-2xl hover:bg-orange-50 hover:text-earthy hover:border-orange-200 transition-all shadow-sm flex items-center gap-2">
                        <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 8V7m0 1v8" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                        Subscriptions
                    </a>
                    <button onclick="runTriage()" id="triageBtn" class="px-6 py-3.5 bg-earthy text-white font-bold rounded-2xl shadow-lg shadow-earthy/20 hover:bg-[#382319] hover:scale-[1.02] transition-all flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                        Run AI Triage
                    </button>
                </div>
            </div>

            <!-- Enhanced KPI Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-6 mb-10">
                <div class="glass-panel p-6 rounded-[28px] hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Live Artisans</p>
                    <h3 class="text-3xl font-bold text-earthy"><%= metrics.totalStores %></h3>
                </div>
                <div class="glass-panel p-6 rounded-[28px] hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Pending Review</p>
                    <div class="flex items-center gap-3">
                        <h3 class="text-3xl font-bold <%= metrics.pendingStores > 0 ? 'text-orange-500' : 'text-earthy' %>"><%= metrics.pendingStores %></h3>
                        <% if (metrics.pendingStores > 0) { %>
                            <span class="w-2.5 h-2.5 bg-orange-500 rounded-full animate-ping"></span>
                        <% } %>
                    </div>
                </div>
                <div class="glass-panel p-6 rounded-[28px] hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Products</p>
                    <h3 class="text-3xl font-bold text-earthy"><%= metrics.totalProducts %></h3>
                </div>
                <div class="glass-panel p-6 rounded-[28px] hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Active Subs</p>
                    <h3 class="text-3xl font-bold text-green-600"><%= metrics.activeSubs %></h3>
                </div>
                <div class="glass-panel p-6 rounded-[28px] hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">24h Traffic</p>
                    <h3 class="text-3xl font-bold text-earthy"><%= metrics.dailyVisits %></h3>
                </div>
                <div class="glass-panel p-6 rounded-[28px] hover:shadow-lg hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
                    <div class="absolute inset-0 bg-orange-50 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <div class="relative z-10">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Storage Health</p>
                        <h3 class="text-xl font-bold text-earthy mb-2"><%= metrics.storageHealth %></h3>
                        <div class="w-full h-1.5 bg-gray-200 rounded-full overflow-hidden">
                            <div class="h-full <%= metrics.storageUsedPct > 80 ? 'bg-red-500' : 'bg-green-400' %>" style="width: <%= metrics.storageUsedPct %>%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Split Layout -->
            <div class="flex flex-col xl:flex-row gap-10">
                
                <!-- Left Panel: Large Chart (70%) -->
                <div class="xl:w-[70%] flex flex-col gap-10">
                    <div class="glass-panel p-8 lg:p-10 rounded-[35px] flex-grow flex flex-col">
                        <div class="flex justify-between items-center mb-8">
                            <div>
                                <h3 class="text-2xl font-bold text-earthy tracking-tight">Ecosystem Traffic</h3>
                                <p class="text-sm text-gray-400 mt-1">Platform engagement over the last 7 days</p>
                            </div>
                            <div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-2 flex gap-4 text-sm font-bold text-gray-400">
                                <button class="text-earthy">7D</button>
                                <button class="hover:text-earthy">30D</button>
                                <button class="hover:text-earthy">1Y</button>
                            </div>
                        </div>
                        <div class="flex-grow w-full relative min-h-[350px]">
                            <canvas id="visitChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Right Panel: Activity Feed (30%) -->
                <div class="xl:w-[30%]">
                    <div class="glass-panel p-8 rounded-[35px] h-full flex flex-col max-h-[600px]">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-2xl font-bold text-earthy tracking-tight">Live Activity</h3>
                            <span class="relative flex h-3 w-3">
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                              <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                            </span>
                        </div>
                        
                        <div class="flex-grow overflow-y-auto no-scrollbar space-y-4 pr-2">
                            <% if (notifications.length === 0) { %>
                                <p class="text-center text-gray-400 text-sm py-10">No recent activity detected.</p>
                            <% } else { %>
                                <% notifications.forEach(note => { %>
                                    <a href="<%= note.link %>" class="block group">
                                        <div class="bg-white/60 p-4 rounded-2xl border border-white hover:bg-white hover:shadow-md hover:border-orange-100 transition-all">
                                            <div class="flex justify-between items-start mb-2">
                                                <span class="text-[10px] font-bold uppercase tracking-widest <%= note.priority === 'high' ? 'text-orange-500' : 'text-gray-400' %>">
                                                    <%= note.type %>
                                                </span>
                                                <span class="text-[10px] text-gray-400 font-bold">
                                                    <%= new Date(note.time).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                                </span>
                                            </div>
                                            <p class="text-sm font-semibold text-earthy group-hover:text-orange-600 transition-colors leading-tight">
                                                <%= note.message %>
                                            </p>
                                        </div>
                                    </a>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>
                
            </div>

        </div>
    </main>

    <script>
        // Chart configuration with modern styling
        const ctx = document.getElementById('visitChart').getContext('2d');
        
        // Create subtle gradient
        const gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(74, 48, 34, 0.15)'); // Earthy
        gradient.addColorStop(1, 'rgba(74, 48, 34, 0.0)');
        
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    label: 'Platform Visits',
                    data: [450, 520, 480, 610, 580, 720, 850],
                    borderColor: '#4A3022',
                    borderWidth: 4,
                    tension: 0.4,
                    fill: true,
                    backgroundColor: gradient,
                    pointBackgroundColor: '#FFFFFF',
                    pointBorderColor: '#4A3022',
                    pointBorderWidth: 3,
                    pointRadius: 6,
                    pointHoverRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#4A3022',
                        titleFont: { family: 'Outfit', size: 13 },
                        bodyFont: { family: 'Outfit', size: 14, weight: 'bold' },
                        padding: 12,
                        cornerRadius: 12,
                        displayColors: false
                    }
                },
                scales: {
                    y: { 
                        display: true, 
                        grid: { color: 'rgba(0,0,0,0.03)', drawBorder: false },
                        ticks: { font: { family: 'Outfit', size: 12 }, color: '#9CA3AF' }
                    },
                    x: { 
                        grid: { display: false, drawBorder: false },
                        ticks: { font: { family: 'Outfit', size: 12 }, color: '#9CA3AF' }
                    }
                },
                interaction: {
                    mode: 'index',
                    intersect: false,
                }
            }
        });

        async function runTriage() {
            const btn = document.getElementById('triageBtn');
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<span class="animate-spin mr-2">⏳</span> Processing...';
            btn.disabled = true;

            try {
                const response = await fetch('/admin/products/run-triage', { method: 'POST' });
                const data = await response.json();
                alert(`Triage complete! Processed ${data.processed} items.`);
                location.reload();
            } catch (error) {
                alert('Triage failed to start.');
            } finally {
                btn.innerHTML = originalContent;
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
