<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #fff8f5; color: #4a3728; }
        .text-earthy { color: #6f4627; }
        .bg-earthy { background-color: #6f4627; }
    </style>
</head>
<body class="flex bg-[#fff8f5]">
    <%- include('partials/admin_sidebar') %>

    <main class="flex-grow ml-80 p-12 min-h-screen">
        <div class="max-w-[1600px] mx-auto">
            
            <div class="flex justify-between items-center mb-12">
                <div>
                    <h1 class="text-4xl font-bold text-earthy tracking-tight">Treasury Watch</h1>
                    <p class="text-gray-500 mt-2">Monitor all platform revenue and artisan subscriptions.</p>
                </div>
                <div class="flex gap-4">
                    <div class="bg-white px-6 py-4 rounded-2xl shadow-sm border border-orange-50">
                        <p class="text-xs font-bold text-gray-400 uppercase">Total Revenue</p>
                        <p class="text-2xl font-bold text-earthy">Rp <%= transactions.reduce((sum, t) => sum + parseInt(t.price), 0).toLocaleString() %></p>
                    </div>
                </div>
            </div>

            <!-- Transactions Table -->
            <div class="bg-white rounded-[40px] shadow-sm border border-orange-50 overflow-hidden">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-orange-50/50">
                            <th class="px-8 py-6 text-sm font-bold text-gray-400 uppercase tracking-wider">Order ID</th>
                            <th class="px-8 py-6 text-sm font-bold text-gray-400 uppercase tracking-wider">Entity</th>
                            <th class="px-8 py-6 text-sm font-bold text-gray-400 uppercase tracking-wider">Product</th>
                            <th class="px-8 py-6 text-sm font-bold text-gray-400 uppercase tracking-wider">Amount</th>
                            <th class="px-8 py-6 text-sm font-bold text-gray-400 uppercase tracking-wider">Date</th>
                            <th class="px-8 py-6 text-sm font-bold text-gray-400 uppercase tracking-wider">Status</th>
                            <th class="px-8 py-6 text-sm font-bold text-gray-400 uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-orange-50">
                        <% transactions.forEach(tx => { %>
                            <tr class="hover:bg-orange-50/30 transition-all">
                                <td class="px-8 py-6 font-mono text-xs text-gray-500"><%= tx.order_id %></td>
                                <td class="px-8 py-6">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-earthy"><%= tx.store_name || tx.phone_number || 'N/A' %></span>
                                        <span class="text-xs text-gray-400 uppercase font-bold tracking-tighter"><%= tx.type %></span>
                                    </div>
                                </td>
                                <td class="px-8 py-6 text-sm text-gray-600"><%= tx.product || tx.variant %></td>
                                <td class="px-8 py-6 font-bold text-earthy">Rp <%= parseInt(tx.price).toLocaleString() %></td>
                                <td class="px-8 py-6 text-sm text-gray-500">
                                    <%= new Date(tx.settled_at || tx.order_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                </td>
                                <td class="px-8 py-6">
                                    <span class="px-3 py-1 rounded-full text-xs font-bold <%= (tx.status === 'Progress' || tx.settled_at) ? 'bg-green-100 text-green-600' : 'bg-orange-100 text-orange-600' %>">
                                        <%= (tx.status === 'Progress' || tx.settled_at) ? 'Settled' : 'Pending' %>
                                    </span>
                                </td>
                                <td class="px-8 py-6 text-right">
                                    <button onclick="syncStatus('<%= tx.order_id %>')" class="p-2 hover:bg-earthy hover:text-white rounded-xl transition-all text-earthy">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        </div>
    </main>

    <script>
        async function syncStatus(orderId) {
            try {
                const response = await fetch(`/api/midtrans/status/${orderId}`);
                const data = await response.json();
                alert(`Current status for ${orderId}: ${data.status}`);
                location.reload();
            } catch (error) {
                alert('Failed to sync status.');
            }
        }
    </script>
</body>
</html>
