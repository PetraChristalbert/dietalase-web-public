<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #fff8f5; color: #4a3728; }
        .bg-earthy { background-color: #6f4627; }
        .text-earthy { color: #6f4627; }
        .border-earthy { border-color: #6f4627; }
        .btn-approve { background-color: #6f4627; color: white; transition: all 0.3s ease; }
        .btn-approve:hover { background-color: #5a3920; transform: translateY(-1px); }
    </style>
</head>
<body class="flex bg-[#fff8f5]">
    <%- include('partials/admin_sidebar') %>

    <!-- Main Content Area -->
    <main class="flex-grow ml-80 p-12 min-h-screen">
        <div class="max-w-[1600px] mx-auto">
            
            <!-- Header -->
            <div class="flex justify-between items-center mb-12">
                <div>
                    <h1 class="text-4xl font-bold text-earthy tracking-tight">Artisan Curation</h1>
                    <p class="text-gray-500 mt-2">Carefully review and verify new shops for the platform.</p>
                </div>
                <div class="bg-white px-8 py-4 rounded-2xl shadow-sm border border-orange-50">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">Pending Review</span>
                    <p class="text-2xl font-bold text-earthy"><%= stores.length %></p>
                </div>
            </div>

            <!-- Queue -->
            <div class="space-y-8">
                <% if (stores.length === 0) { %>
                    <div class="bg-white p-20 rounded-[40px] text-center border-2 border-dashed border-orange-100">
                        <div class="w-20 h-20 bg-orange-50 rounded-3xl flex items-center justify-center mx-auto mb-6 text-earthy">
                            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                        </div>
                        <h3 class="text-2xl font-bold text-earthy">All Clear!</h3>
                        <p class="text-gray-400 mt-2">There are no pending applications at the moment.</p>
                    </div>
                <% } %>

                <% stores.forEach(store => { 
                    let storeImg = (store.image && (store.image.startsWith('http') || store.image.startsWith('/'))) ? store.image : (store.image ? '/' + store.image : '/images/placeholder.webp');
                    storeImg = storeImg.replace('https://api.dietalase.com', '');
                    
                    let ownerImg = '/images/placeholder.webp';
                    let ktpImg = '/images/placeholder.webp';
                    let regUrl = '#';

                    if (store.owner_image) {
                        if (store.owner_image.trim().startsWith('{')) {
                            try {
                                const parsed = JSON.parse(store.owner_image);
                                ownerImg = (parsed.selfie || '/images/placeholder.webp').replace('https://api.dietalase.com', '');
                                ktpImg = (parsed.ktp || '/images/placeholder.webp').replace('https://api.dietalase.com', '');
                                regUrl = (parsed.business_reg || '#').replace('https://api.dietalase.com', '');
                            } catch (e) {
                                ownerImg = store.owner_image;
                            }
                        } else {
                            ownerImg = store.owner_image;
                        }
                    }
                %>
                    <div id="store-<%= store.sid %>" class="bg-white rounded-[40px] p-10 shadow-sm border border-orange-50 flex flex-col xl:flex-row gap-12 items-stretch transition-all duration-500">
                        <!-- Media Section -->
                        <div class="w-full xl:w-[400px] flex-shrink-0 space-y-4">
                            <div class="aspect-video bg-gray-50 rounded-[32px] overflow-hidden relative group">
                                <img src="<%= storeImg %>" class="w-full h-full object-cover" alt="Store">
                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                    <a href="<%= storeImg %>" target="_blank" class="bg-white px-6 py-2 rounded-full font-bold text-sm">View Full Image</a>
                                </div>
                            </div>
                            <div class="grid grid-cols-3 gap-3">
                                <!-- Selfie dengan KTP -->
                                <div class="h-24 bg-orange-50 rounded-2xl flex items-center justify-center border border-orange-100 group relative overflow-hidden">
                                    <img src="<%= ownerImg %>" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" alt="Selfie">
                                    <p class="absolute bottom-2 left-2 right-2 text-center text-[9px] font-bold text-white bg-black/60 py-0.5 rounded uppercase tracking-tighter">Selfie</p>
                                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
                                        <a href="<%= ownerImg %>" target="_blank" class="bg-white px-2 py-0.5 rounded-full font-bold text-[9px] text-earthy pointer-events-auto">View</a>
                                    </div>
                                </div>
                                <!-- Foto KTP -->
                                <div class="h-24 bg-orange-50 rounded-2xl flex items-center justify-center border border-orange-100 group relative overflow-hidden">
                                    <img src="<%= ktpImg %>" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" alt="KTP">
                                    <p class="absolute bottom-2 left-2 right-2 text-center text-[9px] font-bold text-white bg-black/60 py-0.5 rounded uppercase tracking-tighter">KTP</p>
                                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
                                        <a href="<%= ktpImg %>" target="_blank" class="bg-white px-2 py-0.5 rounded-full font-bold text-[9px] text-earthy pointer-events-auto">View</a>
                                    </div>
                                </div>
                                <!-- Dokumen NIB -->
                                <div class="h-24 bg-gray-50 rounded-2xl flex flex-col items-center justify-center border border-gray-100 hover:bg-gray-100 transition-colors">
                                    <% if (regUrl && regUrl !== '#') { %>
                                        <a href="<%= regUrl %>" target="_blank" class="text-earthy flex flex-col items-center justify-center gap-1 h-full w-full">
                                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                            <span class="text-[9px] font-bold uppercase tracking-tighter">NIB Doc</span>
                                        </a>
                                    <% } else { %>
                                        <div class="text-gray-300 flex flex-col items-center justify-center gap-1 h-full w-full">
                                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                            <span class="text-[9px] font-bold uppercase tracking-tighter text-gray-400">No NIB</span>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Details Section -->
                        <div class="flex-grow flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-start mb-8">
                                    <div>
                                        <h2 class="text-3xl font-bold text-earthy"><%= store.name %></h2>
                                        <p class="text-lg text-gray-500 font-medium"><%= store.type %></p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-bold text-earthy uppercase tracking-widest"><%= store.city %></p>
                                        <p class="text-xs text-gray-400 mt-1">Applied <%= new Date(store.created_at).toLocaleDateString() %></p>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-8 mb-10">
                                    <div>
                                        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Responsible Owner</p>
                                        <p class="font-bold text-earthy"><%= store.owner_name %></p>
                                        <p class="text-gray-500"><%= store.contact %></p>
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Artisan Address</p>
                                        <p class="text-gray-600 line-clamp-2"><%= store.address %></p>
                                        <div class="mt-3 flex">
                                            <a href="https://www.google.com/maps/search/?api=1&query=<%= store.latitude %>,<%= store.longitude %>" 
                                               target="_blank" 
                                               class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-50 hover:bg-orange-100 text-earthy font-semibold text-xs border border-orange-100/50 transition-all duration-300">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                </svg>
                                                <span>Lihat di Google Maps</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Actions stick to bottom -->
                            <div class="flex gap-4 mt-8 xl:mt-0">
                                <button 
                                    onmousedown="startHold('<%= store.sid %>', 'approve-instant')" 
                                    onmouseup="cancelHold('<%= store.sid %>')" 
                                    onmouseleave="cancelHold('<%= store.sid %>')" 
                                    ontouchstart="startHold('<%= store.sid %>', 'approve-instant')" 
                                    ontouchend="cancelHold('<%= store.sid %>')" 
                                    class="flex-grow py-5 rounded-[24px] bg-green-50 text-green-700 font-bold hover:bg-green-100 text-lg flex items-center justify-center gap-3 relative overflow-hidden select-none active:scale-[0.98] transition-transform"
                                >
                                    <div id="fill-approve-instant-<%= store.sid %>" class="absolute left-0 top-0 bottom-0 bg-green-500/20 w-0 pointer-events-none"></div>
                                    <span id="btn-text-instant-<%= store.sid %>" class="relative z-10">Verify Instantly</span>
                                    <div id="loader-instant-<%= store.sid %>" class="hidden animate-spin rounded-full h-5 w-5 border-2 border-green-700 border-t-transparent relative z-10"></div>
                                </button>
                                <button 
                                    onmousedown="startHold('<%= store.sid %>', 'approve')" 
                                    onmouseup="cancelHold('<%= store.sid %>')" 
                                    onmouseleave="cancelHold('<%= store.sid %>')" 
                                    ontouchstart="startHold('<%= store.sid %>', 'approve')" 
                                    ontouchend="cancelHold('<%= store.sid %>')" 
                                    class="btn-approve flex-grow py-5 rounded-[24px] font-bold text-lg flex items-center justify-center gap-3 shadow-lg shadow-orange-100 relative overflow-hidden select-none active:scale-[0.98] transition-transform"
                                >
                                    <div id="fill-approve-<%= store.sid %>" class="absolute left-0 top-0 bottom-0 bg-white/20 w-0 pointer-events-none"></div>
                                    <span id="btn-text-<%= store.sid %>" class="relative z-10">AI Verify</span>
                                    <div id="loader-<%= store.sid %>" class="hidden animate-spin rounded-full h-5 w-5 border-2 border-white border-t-transparent relative z-10"></div>
                                </button>
                                <button 
                                    onmousedown="startHold('<%= store.sid %>', 'reject')" 
                                    onmouseup="cancelHold('<%= store.sid %>')" 
                                    onmouseleave="cancelHold('<%= store.sid %>')" 
                                    ontouchstart="startHold('<%= store.sid %>', 'reject')" 
                                    ontouchend="cancelHold('<%= store.sid %>')" 
                                    class="px-8 py-5 rounded-[24px] bg-red-50 text-red-500 font-bold hover:bg-red-100 relative overflow-hidden select-none active:scale-[0.98] transition-transform"
                                >
                                    <div id="fill-reject-<%= store.sid %>" class="absolute left-0 top-0 bottom-0 bg-red-500/20 w-0 pointer-events-none"></div>
                                    <span id="btn-reject-text-<%= store.sid %>" class="relative z-10">Hold to Reject</span>
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

        </div>
    </main>

    <script>
        let holdTimers = {};

        function startHold(sid, action) {
            // Prevent multiple simultaneous timers for the same store
            if (holdTimers[sid]) return;

            const fill = document.getElementById(`fill-${action}-${sid}`);
            if (!fill) return;

            // Reset progress and set linear transition for exactly 1500ms
            fill.style.transition = 'none';
            fill.style.width = '0%';
            
            // Force reflow
            fill.offsetHeight;
            
            // Set 1.5s transition and fill to 100%
            fill.style.transition = 'width 1500ms linear';
            fill.style.width = '100%';

            // Start 1.5s timer
            holdTimers[sid] = {
                action: action,
                timer: setTimeout(() => {
                    // Success! Trigger action
                    triggerAction(sid, action);
                    holdTimers[sid] = null;
                }, 1500)
            };
        }

        function cancelHold(sid) {
            const state = holdTimers[sid];
            if (!state) return;

            // Clear timer
            clearTimeout(state.timer);
            holdTimers[sid] = null;

            const fill = document.getElementById(`fill-${state.action}-${sid}`);
            if (fill) {
                // Fast retract progress bar
                fill.style.transition = 'width 0.3s ease-out';
                fill.style.width = '0%';
            }
        }

        function triggerAction(sid, action) {
            if (action === 'approve') {
                approveStore(sid);
            } else if (action === 'approve-instant') {
                approveStoreInstant(sid);
            } else if (action === 'reject') {
                rejectStore(sid);
            }
        }

        async function approveStoreInstant(sid) {
            const btn = document.getElementById(`btn-text-instant-${sid}`);
            const loader = document.getElementById(`loader-instant-${sid}`);
            const card = document.getElementById(`store-${sid}`);

            btn.innerText = "Verifying...";
            loader.classList.remove('hidden');
            card.style.pointerEvents = 'none';
            
            try {
                const response = await fetch(`/admin/approve-instant/${sid}`, { method: 'POST' });
                const result = await response.json();

                if (result.success) {
                    card.classList.add('opacity-0', 'translate-x-12', 'scale-95');
                    setTimeout(() => {
                        card.remove();
                        if (document.querySelectorAll('[id^="store-"]').length === 0) location.reload();
                    }, 500);
                } else {
                    alert('Error: ' + result.message);
                    btn.innerText = "Verify Instantly";
                    loader.classList.add('hidden');
                    card.style.pointerEvents = 'auto';
                }
            } catch (error) {
                alert('Connection error. Try again.');
                btn.innerText = "Verify Instantly";
                loader.classList.add('hidden');
                card.style.pointerEvents = 'auto';
            }
        }

        async function approveStore(sid) {
            const btn = document.getElementById(`btn-text-${sid}`);
            const loader = document.getElementById(`loader-${sid}`);
            const card = document.getElementById(`store-${sid}`);

            btn.innerText = "Artisan is being curated by AI...";
            loader.classList.remove('hidden');
            
            // Disable all pointer events to prevent interactions during load
            card.style.pointerEvents = 'none';
            
            try {
                const response = await fetch(`/admin/approve/${sid}`, { method: 'POST' });
                const result = await response.json();

                if (result.success) {
                    card.classList.add('opacity-0', 'translate-x-12', 'scale-95');
                    setTimeout(() => {
                        card.remove();
                        if (document.querySelectorAll('[id^="store-"]').length === 0) location.reload();
                    }, 500);
                } else {
                    alert('Error: ' + result.message);
                    btn.innerText = "AI Verify";
                    loader.classList.add('hidden');
                    card.style.pointerEvents = 'auto';
                }
            } catch (error) {
                alert('Connection error. Try again.');
                btn.innerText = "AI Verify";
                loader.classList.add('hidden');
                card.style.pointerEvents = 'auto';
            }
        }

        async function rejectStore(sid) {
            const btn = document.getElementById(`btn-reject-text-${sid}`);
            const card = document.getElementById(`store-${sid}`);

            btn.innerText = "Rejecting...";
            card.style.pointerEvents = 'none';
            
            try {
                const response = await fetch(`/admin/reject/${sid}`, { method: 'POST' });
                const result = await response.json();

                if (result.success) {
                    card.classList.add('opacity-0', '-translate-x-12', 'scale-95');
                    setTimeout(() => {
                        card.remove();
                        if (document.querySelectorAll('[id^="store-"]').length === 0) location.reload();
                    }, 500);
                } else {
                    alert('Error: ' + result.message);
                    btn.innerText = "Hold to Reject";
                    card.style.pointerEvents = 'auto';
                }
            } catch (error) {
                alert('Connection error. Try again.');
                btn.innerText = "Hold to Reject";
                card.style.pointerEvents = 'auto';
            }
        }
    </script>
</body>
</html>
