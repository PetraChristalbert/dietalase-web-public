<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Field Admin - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Outfit', 'sans-serif'] },
                    colors: { earthy: '#5C4033' }
                }
            }
        }
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        input[type="time"]::-webkit-datetime-edit-ampm-field { display: none; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans h-screen flex flex-col overflow-hidden">
    <!-- Header -->
    <header class="bg-white px-5 py-4 flex justify-between items-center shadow-sm z-10 sticky top-0">
        <div class="flex items-center gap-2">
            <img src="/DiEtalase_Icon.png" class="h-6 object-contain" onerror="this.style.display='none'">
            <h1 class="text-xl font-bold text-earthy">DiEtalase Staff</h1>
        </div>
        <a href="/field/logout" class="text-xs font-bold bg-gray-100 text-gray-500 px-4 py-2 rounded-lg hover:bg-gray-200">Logout</a>
    </header>

    <!-- Main Content Area (Scrollable) -->
    <main class="flex-grow overflow-y-auto relative no-scrollbar pb-24" id="mainContainer">
        
        <!-- Search Section -->
        <div class="p-5 bg-white mb-2 shadow-sm relative z-20">
            <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">Find Store</h2>
            <div class="relative">
                <input type="text" id="searchInput" placeholder="Search by SID, Name, or Owner..." class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-earthy text-sm pr-12 shadow-inner" onkeyup="performSearch()">
                <div class="absolute right-4 top-4 text-gray-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
            </div>
            
            <!-- Search Results Dropdown -->
            <div id="searchResults" class="absolute left-5 right-5 top-[90px] bg-white border border-gray-100 rounded-2xl shadow-xl max-h-64 overflow-y-auto hidden z-50 divide-y divide-gray-50">
                <!-- Populated via JS -->
            </div>
        </div>

        <!-- Placeholder when no store selected -->
        <div id="noStoreSelected" class="flex flex-col items-center justify-center p-10 mt-10 opacity-60">
            <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            <p class="text-sm text-gray-500 text-center">Search and select a store above to manage its details and products.</p>
        </div>

        <!-- Store Management Area (Hidden by default) -->
        <div id="storeManagementArea" class="hidden">
            <!-- Tabs -->
            <div class="flex border-b border-gray-200 bg-white sticky top-0 z-10">
                <button onclick="switchTab('details')" id="tab-details" class="flex-1 py-4 text-sm font-bold text-earthy border-b-2 border-earthy transition-all">Store Details</button>
                <button onclick="switchTab('products')" id="tab-products" class="flex-1 py-4 text-sm font-bold text-gray-400 border-b-2 border-transparent transition-all">Products</button>
            </div>

            <!-- Tab Content: Details -->
            <div id="content-details" class="p-5">
                <form id="editStoreForm" onsubmit="submitStoreUpdate(event)">
                    <input type="hidden" id="edit_sid">
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Store Name</label>
                        <input type="text" id="edit_name" required class="w-full p-3 bg-white border border-gray-200 rounded-xl">
                    </div>
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Owner Name</label>
                        <input type="text" id="edit_owner_name" class="w-full p-3 bg-white border border-gray-200 rounded-xl">
                    </div>
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Contact (Phone)</label>
                        <input type="tel" oninput="this.value = this.value.replace(/[^0-9]/g, '')" id="edit_contact" class="w-full p-3 bg-white border border-gray-200 rounded-xl">
                    </div>
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Email</label>
                        <input type="email" id="edit_email" class="w-full p-3 bg-white border border-gray-200 rounded-xl">
                    </div>
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Address</label>
                        <textarea id="edit_address" rows="2" class="w-full p-3 bg-white border border-gray-200 rounded-xl"></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Description</label>
                        <textarea id="edit_description" rows="3" class="w-full p-3 bg-white border border-gray-200 rounded-xl"></textarea>
                    </div>
                    
                    <!-- Operating Hours -->
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-2">Operating Hours (Leave blank if closed)</label>
                        <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-2">
                            <% const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']; %>
                            <% days.forEach((day, idx) => { %>
                            <div class="flex items-center gap-2">
                                <span class="w-10 text-xs font-bold text-gray-400"><%= day %></span>
                                <input type="text" placeholder="HH:MM" maxlength="5" oninput="formatTimeInput(this)" id="edit_open_<%= idx + 1 %>" class="flex-1 min-w-0 p-2 bg-white border border-gray-200 rounded-lg text-xs text-center" <%- idx === 0 ? 'onchange="syncMondayTime(\'edit\')"' : '' %>>
                                <span class="text-gray-400 text-xs">-</span>
                                <input type="text" placeholder="HH:MM" maxlength="5" oninput="formatTimeInput(this)" id="edit_close_<%= idx + 1 %>" class="flex-1 min-w-0 p-2 bg-white border border-gray-200 rounded-lg text-xs text-center" <%- idx === 0 ? 'onchange="syncMondayTime(\'edit\')"' : '' %>>
                            </div>
                            <% }); %>
                        </div>
                    </div>

                    <!-- Social Media -->
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Instagram URL</label>
                        <input type="url" id="edit_instagram" class="w-full p-3 bg-white border border-gray-200 rounded-xl" placeholder="https://instagram.com/...">
                    </div>
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Facebook URL</label>
                        <input type="url" id="edit_facebook" class="w-full p-3 bg-white border border-gray-200 rounded-xl" placeholder="https://facebook.com/...">
                    </div>
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">TikTok URL</label>
                        <input type="url" id="edit_tiktok" class="w-full p-3 bg-white border border-gray-200 rounded-xl" placeholder="https://tiktok.com/@...">
                    </div>
                    
                    <!-- Images -->
                    <div class="mb-4">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Store Image</label>
                        <div class="flex gap-3 items-center mb-2">
                            <img id="preview_edit_image" src="" class="w-12 h-12 rounded-lg object-cover bg-gray-100 hidden">
                            <input type="file" id="edit_image" accept="image/*" class="flex-1 p-2 bg-white border border-gray-200 rounded-xl text-sm">
                        </div>
                    </div>
                    <div class="mb-6">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Owner Image</label>
                        <div class="flex gap-3 items-center mb-2">
                            <img id="preview_edit_owner_image" src="" class="w-12 h-12 rounded-lg object-cover bg-gray-100 hidden">
                            <input type="file" id="edit_owner_image" accept="image/*" class="flex-1 p-2 bg-white border border-gray-200 rounded-xl text-sm">
                        </div>
                    </div>
                    
                    <button type="button" onclick="getGPS('edit_lat', 'edit_lng')" class="w-full py-3 bg-amber-50 text-amber-700 font-bold rounded-xl mb-2 flex items-center justify-center gap-2 border border-amber-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        Update GPS Location
                    </button>
                    <p class="text-[10px] text-gray-400 text-center mb-4 leading-tight px-4">This will request the most exact coordinates from your device's GPS hardware.</p>
                    <div class="flex gap-2 mb-6 hidden items-center" id="edit_gps_display">
                        <input type="text" id="edit_lat" readonly class="flex-1 p-2 text-xs bg-gray-100 rounded-lg text-center" placeholder="Lat">
                        <input type="text" id="edit_lng" readonly class="flex-1 p-2 text-xs bg-gray-100 rounded-lg text-center" placeholder="Lng">
                        <a href="#" target="_blank" id="edit_map_link" class="text-earthy p-2 bg-orange-100 rounded-lg hover:bg-orange-200" title="Verify on Map">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
                        </a>
                    </div>
                    <div class="flex gap-3">
                        <button type="button" onclick="deleteCurrentStore()" class="flex-1 py-3.5 bg-red-50 text-red-600 border border-red-200 font-bold rounded-xl shadow-sm">Delete Store</button>
                        <button type="submit" class="flex-[2] py-3.5 bg-earthy text-white font-bold rounded-xl shadow-md">Save Changes</button>
                    </div>
                </form>
            </div>

            <!-- Tab Content: Products -->
            <div id="content-products" class="hidden p-5">
                <button onclick="openProductModal()" class="w-full py-4 bg-orange-50 text-earthy border border-orange-200 font-bold rounded-2xl mb-6 shadow-sm flex items-center justify-center gap-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Add New Product
                </button>

                <div id="productList" class="flex flex-col gap-4">
                    <!-- Loaded via JS -->
                </div>
            </div>
        </div>
    </main>

    <!-- FAB: Register New Store -->
    <button onclick="openRegisterStore()" class="fixed bottom-6 right-6 w-16 h-16 bg-earthy text-white rounded-full shadow-2xl flex items-center justify-center hover:scale-105 transition-transform z-40 p-3">
        <img src="/images/store.png" class="w-10 h-10 object-contain filter invert brightness-0" onerror="this.style.display='none'">
    </button>

    <!-- Modal: Register Store -->
    <div id="registerStoreModal" class="fixed inset-0 bg-white z-[60] hidden flex-col">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-4 bg-white sticky top-0 shadow-sm">
            <button onclick="closeRegisterStore()" class="p-2 bg-gray-50 rounded-full text-gray-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg></button>
            <h2 class="font-bold text-lg text-earthy">Register Store</h2>
        </div>
        <div class="p-5 overflow-y-auto pb-20">
            <form id="registerStoreForm" onsubmit="submitNewStore(event)">
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Store Name *</label>
                    <input type="text" id="reg_name" required class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl">
                </div>
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Owner Name</label>
                    <input type="text" id="reg_owner_name" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl">
                </div>
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Phone Number</label>
                    <input type="tel" oninput="this.value = this.value.replace(/[^0-9]/g, '')" id="reg_contact" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl">
                </div>
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Email</label>
                    <input type="email" id="reg_email" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl">
                </div>
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Address *</label>
                    <textarea id="reg_address" required rows="2" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl"></textarea>
                </div>
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Description</label>
                    <textarea id="reg_description" rows="3" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl"></textarea>
                </div>
                
                <!-- Operating Hours -->
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-2">Operating Hours (Leave blank if closed)</label>
                    <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex flex-col gap-2">
                        <% const reg_days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']; %>
                        <% reg_days.forEach((day, idx) => { %>
                        <div class="flex items-center gap-2">
                            <span class="w-10 text-xs font-bold text-gray-400"><%= day %></span>
                            <input type="text" placeholder="HH:MM" maxlength="5" oninput="formatTimeInput(this)" id="reg_open_<%= idx + 1 %>" class="flex-1 min-w-0 p-2 bg-white border border-gray-200 rounded-lg text-xs text-center" <%- idx === 0 ? 'onchange="syncMondayTime(\'reg\')"' : '' %>>
                            <span class="text-gray-400 text-xs">-</span>
                            <input type="text" placeholder="HH:MM" maxlength="5" oninput="formatTimeInput(this)" id="reg_close_<%= idx + 1 %>" class="flex-1 min-w-0 p-2 bg-white border border-gray-200 rounded-lg text-xs text-center" <%- idx === 0 ? 'onchange="syncMondayTime(\'reg\')"' : '' %>>
                        </div>
                        <% }); %>
                    </div>
                </div>

                <!-- Social Media -->
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Instagram URL</label>
                    <input type="url" id="reg_instagram" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl" placeholder="https://instagram.com/...">
                </div>
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Facebook URL</label>
                    <input type="url" id="reg_facebook" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl" placeholder="https://facebook.com/...">
                </div>
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">TikTok URL</label>
                    <input type="url" id="reg_tiktok" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl" placeholder="https://tiktok.com/@...">
                </div>
                
                <button type="button" onclick="getGPS('reg_lat', 'reg_lng')" class="w-full py-4 bg-amber-50 text-amber-700 font-bold rounded-xl mb-2 flex items-center justify-center gap-2 border border-amber-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    Fetch Accurate GPS
                </button>
                <p class="text-[10px] text-gray-400 text-center mb-4 leading-tight px-4">Uses the highest precision hardware GPS available. Please wait a few seconds if outside.</p>
                <div class="flex gap-2 mb-6 hidden items-center" id="reg_gps_display">
                    <input type="text" id="reg_lat" readonly class="flex-1 p-2 text-xs bg-gray-100 rounded-lg text-center" placeholder="Lat">
                    <input type="text" id="reg_lng" readonly class="flex-1 p-2 text-xs bg-gray-100 rounded-lg text-center" placeholder="Lng">
                    <a href="#" target="_blank" id="reg_map_link" class="text-earthy p-2 bg-orange-100 rounded-lg hover:bg-orange-200" title="Verify on Map">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
                    </a>
                </div>

                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Store Photo</label>
                    <input type="file" id="reg_image" accept="image/*" class="w-full p-3 bg-gray-50 border border-gray-200 rounded-xl text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100">
                </div>
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Owner Photo</label>
                    <input type="file" id="reg_owner_image" accept="image/*" class="w-full p-3 bg-gray-50 border border-gray-200 rounded-xl text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100">
                </div>

                <button type="submit" class="w-full py-4 mt-6 bg-earthy text-white font-bold rounded-xl shadow-lg">Register Store Now</button>
            </form>
        </div>
    </div>

    <!-- Bottom Sheet Modal: Add/Edit Product -->
    <div id="productModal" class="fixed inset-0 bg-black/50 z-[70] hidden flex-col justify-end">
        <div class="bg-white rounded-t-3xl p-5 w-full max-h-[90vh] overflow-y-auto transform transition-transform translate-y-full" id="productModalContent">
            <div class="flex justify-between items-center mb-6">
                <h2 class="font-bold text-xl text-earthy" id="prodModalTitle">Add Product</h2>
                <button onclick="closeProductModal()" class="p-2 bg-gray-100 rounded-full"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
            </div>
            <form id="productForm" onsubmit="submitProduct(event)">
                <input type="hidden" id="prod_pid">
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Product Name *</label>
                    <input type="text" id="prod_name" required class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl">
                </div>
                <div class="flex gap-4 mb-4">
                    <div class="flex-1">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Price (Rp) *</label>
                        <input type="number" id="prod_price" required class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl">
                    </div>
                    <div class="w-24">
                        <label class="text-xs font-bold text-gray-500 block mb-1">Unit</label>
                        <input type="text" id="prod_unit" placeholder="item" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="text-xs font-bold text-gray-500 block mb-1">Description</label>
                    <textarea id="prod_desc" rows="3" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl"></textarea>
                </div>
                <div class="mb-6">
                    <label class="text-xs font-bold text-gray-500 block mb-1" id="prod_image_label">Product Photo (Camera) *</label>
                    <div class="flex gap-3 items-center mb-2">
                        <img id="preview_prod_image" src="" class="w-12 h-12 rounded-lg object-cover bg-gray-100 hidden">
                        <input type="file" id="prod_image" accept="image/*" capture="environment" class="flex-1 p-2 bg-gray-50 border border-gray-200 rounded-xl text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-orange-50 file:text-orange-700">
                    </div>
                </div>
                
                <div class="flex gap-3">
                    <button type="button" id="btnDeleteProd" onclick="deleteProduct()" class="hidden flex-1 py-4 bg-red-50 text-red-600 font-bold rounded-xl border border-red-100">Delete</button>
                    <button type="submit" class="flex-[2] py-4 bg-earthy text-white font-bold rounded-xl shadow-lg">Save Product</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        let currentStoreSid = null;
        let allStoresData = [];
        
        // Load all stores on startup
        window.onload = async () => {
            try {
                const res = await fetch('/field/api/stores/all');
                const data = await res.json();
                if (data.success) {
                    allStoresData = data.stores;
                }
            } catch(e) {
                console.error("Failed to preload stores");
            }
        };

        // --- Operating Hours Auto-fill Logic ---
        function formatTimeInput(input) {
            let val = input.value.replace(/[^0-9]/g, '');
            if (val.length > 2) {
                val = val.substring(0, 2) + ':' + val.substring(2);
            }
            if (input.value !== val) {
                input.value = val;
            }
            clearHint({ target: input });
        }

        function syncMondayTime(prefix) {
            const monOpen = document.getElementById(prefix + '_open_1').value;
            const monClose = document.getElementById(prefix + '_close_1').value;

            // Only sync if they look complete (5 chars like 12:00)
            const openValid = monOpen.length === 5;
            const closeValid = monClose.length === 5;

            for (let i = 2; i <= 7; i++) {
                const openInput = document.getElementById(prefix + '_open_' + i);
                const closeInput = document.getElementById(prefix + '_close_' + i);

                if (openValid && (!openInput.value || openInput.dataset.hint === 'true')) {
                    openInput.value = monOpen;
                    openInput.classList.add('text-gray-400', 'bg-gray-50');
                    openInput.dataset.hint = 'true';
                }
                if (closeValid && (!closeInput.value || closeInput.dataset.hint === 'true')) {
                    closeInput.value = monClose;
                    closeInput.classList.add('text-gray-400', 'bg-gray-50');
                    closeInput.dataset.hint = 'true';
                }
            }
        }

        function clearHint(e) {
            e.target.classList.remove('text-gray-400', 'bg-gray-50');
            e.target.dataset.hint = 'false';
        }

        document.addEventListener('DOMContentLoaded', () => {
            ['reg', 'edit'].forEach(prefix => {
                for (let i = 2; i <= 7; i++) {
                    const openInput = document.getElementById(prefix + '_open_' + i);
                    const closeInput = document.getElementById(prefix + '_close_' + i);
                    if(openInput) {
                        openInput.addEventListener('input', clearHint);
                        openInput.addEventListener('focus', clearHint);
                    }
                    if(closeInput) {
                        closeInput.addEventListener('input', clearHint);
                        closeInput.addEventListener('focus', clearHint);
                    }
                }
            });
        });

        // Instant local search
        function performSearch() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            const resDiv = document.getElementById('searchResults');
            
            if (q.length < 1) {
                resDiv.classList.add('hidden');
                return;
            }
            
            const filtered = allStoresData.filter(s => 
                s.sid.toString().includes(q) || 
                (s.name && s.name.toLowerCase().includes(q)) || 
                (s.owner_name && s.owner_name.toLowerCase().includes(q))
            ).slice(0, 15);
            
            if (filtered.length > 0) {
                let html = '';
                filtered.forEach(s => {
                    const escName = s.name ? s.name.replace(/'/g, "\\'") : '';
                    const displayLabel = `[${s.sid}] ${s.name} ${s.owner_name ? `(${s.owner_name})` : ''}`;
                    html += `
                        <div onclick="selectStore(${s.sid}, '${escName}')" class="p-4 hover:bg-orange-50 active:bg-orange-100 cursor-pointer flex items-center gap-4">
                            <div>
                                <h4 class="font-bold text-earthy text-sm line-clamp-1">${displayLabel}</h4>
                            </div>
                        </div>
                    `;
                });
                resDiv.innerHTML = html;
                resDiv.classList.remove('hidden');
            } else {
                resDiv.innerHTML = '<div class="p-4 text-center text-sm text-gray-500">No stores found.</div>';
                resDiv.classList.remove('hidden');
            }
        }

        async function selectStore(sid, displayName) {
            currentStoreSid = sid;
            document.getElementById('searchInput').value = displayName;
            document.getElementById('searchResults').classList.add('hidden');
            
            document.getElementById('noStoreSelected').classList.add('hidden');
            const mgmtArea = document.getElementById('storeManagementArea');
            mgmtArea.classList.remove('hidden');
            
            // Loading state
            document.getElementById('content-details').classList.add('opacity-50');
            
            try {
                const res = await fetch(`/field/api/stores/${sid}/details`);
                const data = await res.json();
                
                if (data.success) {
                    const store = data.store;
                    document.getElementById('edit_sid').value = store.sid;
                    document.getElementById('edit_name').value = store.name || '';
                    document.getElementById('edit_address').value = store.address || '';
                    document.getElementById('edit_owner_name').value = store.owner_name || '';
                    document.getElementById('edit_contact').value = store.contact || '';
                    document.getElementById('edit_email').value = store.email || '';
                    document.getElementById('edit_description').value = store.description || '';
                    
                    // Reset operating hours grid
                    for(let i=1; i<=7; i++) {
                        document.getElementById(`edit_open_${i}`).value = '';
                        document.getElementById(`edit_close_${i}`).value = '';
                    }
                    if (store.operating_hours && store.operating_hours.length > 0) {
                        store.operating_hours.forEach(oh => {
                            if (document.getElementById(`edit_open_${oh.day_of_week}`)) {
                                document.getElementById(`edit_open_${oh.day_of_week}`).value = oh.open_time ? oh.open_time.substring(0,5) : '';
                                document.getElementById(`edit_close_${oh.day_of_week}`).value = oh.close_time ? oh.close_time.substring(0,5) : '';
                            }
                        });
                    }

                    document.getElementById('edit_instagram').value = store.instagram || '';
                    document.getElementById('edit_facebook').value = store.facebook || '';
                    document.getElementById('edit_tiktok').value = store.tiktok || '';
                    
                    if (store.image) {
                        document.getElementById('preview_edit_image').src = store.image;
                        document.getElementById('preview_edit_image').classList.remove('hidden');
                    } else {
                        document.getElementById('preview_edit_image').classList.add('hidden');
                    }
                    if (store.owner_image) {
                        document.getElementById('preview_edit_owner_image').src = store.owner_image;
                        document.getElementById('preview_edit_owner_image').classList.remove('hidden');
                    } else {
                        document.getElementById('preview_edit_owner_image').classList.add('hidden');
                    }
                }
            } catch(e) {
                showAlert("Failed to fetch store details");
            }
            
            document.getElementById('content-details').classList.remove('opacity-50');
            
            // Switch to details tab by default
            switchTab('details');
            loadProducts(sid);
        }

        // Tabs
        function switchTab(tab) {
            if (tab === 'details') {
                document.getElementById('content-details').classList.remove('hidden');
                document.getElementById('content-products').classList.add('hidden');
                document.getElementById('tab-details').className = 'flex-1 py-4 text-sm font-bold text-earthy border-b-2 border-earthy transition-all';
                document.getElementById('tab-products').className = 'flex-1 py-4 text-sm font-bold text-gray-400 border-b-2 border-transparent transition-all';
            } else {
                document.getElementById('content-details').classList.add('hidden');
                document.getElementById('content-products').classList.remove('hidden');
                document.getElementById('tab-products').className = 'flex-1 py-4 text-sm font-bold text-earthy border-b-2 border-earthy transition-all';
                document.getElementById('tab-details').className = 'flex-1 py-4 text-sm font-bold text-gray-400 border-b-2 border-transparent transition-all';
            }
        }

        // GPS
        function getGPS(latId, lngId) {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        document.getElementById(latId).value = lat;
                        document.getElementById(lngId).value = lng;
                        document.getElementById(latId).parentElement.classList.remove('hidden');
                        
                        const linkId = latId === 'edit_lat' ? 'edit_map_link' : 'reg_map_link';
                        document.getElementById(linkId).href = `https://www.google.com/maps?q=${lat},${lng}`;
                        

                    },
                    (error) => showAlert("Failed to get GPS: " + error.message),
                    { enableHighAccuracy: true, maximumAge: 0, timeout: 15000 }
                );
            } else {
                showAlert("Geolocation is not supported by this browser.");
            }
        }

        // Store Registration
        function openRegisterStore() {
            document.getElementById('registerStoreModal').classList.remove('hidden');
            document.getElementById('registerStoreModal').classList.add('flex');
            document.getElementById('registerStoreForm').reset();
            document.getElementById('reg_gps_display').classList.add('hidden');
        }
        function closeRegisterStore() {
            document.getElementById('registerStoreModal').classList.add('hidden');
            document.getElementById('registerStoreModal').classList.remove('flex');
        }

        async function submitNewStore(e) {
            e.preventDefault();
            const formData = new FormData();
            formData.append('name', document.getElementById('reg_name').value);
            formData.append('owner_name', document.getElementById('reg_owner_name').value);
            formData.append('contact', document.getElementById('reg_contact').value);
            formData.append('email', document.getElementById('reg_email').value);
            formData.append('address', document.getElementById('reg_address').value);
            formData.append('description', document.getElementById('reg_description').value);
            
            // Collect hours
            const operating_hours = [];
            for (let i = 1; i <= 7; i++) {
                const open = document.getElementById(`reg_open_${i}`).value;
                const close = document.getElementById(`reg_close_${i}`).value;
                if (open || close) {
                    operating_hours.push({ day_of_week: i, open_time: open, close_time: close });
                }
            }
            formData.append('operating_hours', JSON.stringify(operating_hours));

            formData.append('instagram', document.getElementById('reg_instagram').value);
            formData.append('facebook', document.getElementById('reg_facebook').value);
            formData.append('tiktok', document.getElementById('reg_tiktok').value);
            formData.append('lat', document.getElementById('reg_lat').value);
            formData.append('lng', document.getElementById('reg_lng').value);
            
            const imgFile = document.getElementById('reg_image').files[0];
            if (imgFile) formData.append('image', imgFile);
            const ownerImgFile = document.getElementById('reg_owner_image').files[0];
            if (ownerImgFile) formData.append('owner_image', ownerImgFile);

            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerText = "Registering...";
            btn.disabled = true;

            try {
                const res = await fetch('/field/api/stores/register', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    showAlert("Store Registered successfully!");
                    closeRegisterStore();
                    
                    // Add to local data
                    const newName = document.getElementById('reg_name').value;
                    allStoresData.unshift({
                        sid: data.sid, 
                        name: newName, 
                        owner_name: document.getElementById('reg_owner_name').value 
                    });
                    
                    selectStore(data.sid, newName);
                } else {
                    showAlert("Failed: " + data.message);
                }
            } catch(e) { showAlert("Error connecting to server."); }
            
            btn.innerText = "Register Store Now";
            btn.disabled = false;
        }

        async function submitStoreUpdate(e) {
            e.preventDefault();
            if(!currentStoreSid) return;

            const formData = new FormData();
            formData.append('name', document.getElementById('edit_name').value);
            formData.append('owner_name', document.getElementById('edit_owner_name').value);
            formData.append('contact', document.getElementById('edit_contact').value);
            formData.append('email', document.getElementById('edit_email').value);
            formData.append('address', document.getElementById('edit_address').value);
            formData.append('description', document.getElementById('edit_description').value);
            
            // Collect hours
            const operating_hours = [];
            for (let i = 1; i <= 7; i++) {
                const open = document.getElementById(`edit_open_${i}`).value;
                const close = document.getElementById(`edit_close_${i}`).value;
                if (open || close) {
                    operating_hours.push({ day_of_week: i, open_time: open, close_time: close });
                }
            }
            formData.append('operating_hours', JSON.stringify(operating_hours));

            formData.append('instagram', document.getElementById('edit_instagram').value);
            formData.append('facebook', document.getElementById('edit_facebook').value);
            formData.append('tiktok', document.getElementById('edit_tiktok').value);
            formData.append('lat', document.getElementById('edit_lat').value);
            formData.append('lng', document.getElementById('edit_lng').value);
            
            const imgFile = document.getElementById('edit_image').files[0];
            if (imgFile) formData.append('image', imgFile);
            const ownerImgFile = document.getElementById('edit_owner_image').files[0];
            if (ownerImgFile) formData.append('owner_image', ownerImgFile);

            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerText = "Saving..."; btn.disabled = true;

            try {
                const res = await fetch(`/field/api/stores/${currentStoreSid}/update`, { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) showAlert("Store details updated!");
                else showAlert("Failed: " + data.message);
            } catch(e) { showAlert("Error connecting to server."); }
            
            btn.innerText = "Save Changes"; btn.disabled = false;
        }

        async function deleteCurrentStore() {
            if (!currentStoreSid) return;
            const confirm1 = await showConfirm("WARNING: You are about to permanently delete this store, all of its products, and all associated images.\n\nAre you absolutely sure you want to proceed?");
            if (!confirm1) return;

            const confirm2 = await showConfirm("FINAL WARNING: This action CANNOT be undone. Click OK to confirm.");
            if (!confirm2) return;

            try {
                const res = await fetch(`/field/api/stores/${currentStoreSid}/delete`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    showAlert("Store and all its data have been permanently deleted.");
                    // Remove from local array
                    allStoresData = allStoresData.filter(s => s.sid != currentStoreSid);
                    // Reset UI
                    document.getElementById('searchInput').value = '';
                    document.getElementById('storeManagementArea').classList.add('hidden');
                    document.getElementById('noStoreSelected').classList.remove('hidden');
                    currentStoreSid = null;
                } else {
                    showAlert("Failed to delete store: " + data.message);
                }
            } catch(e) {
                showAlert("Error connecting to server.");
            }
        }

        // Product Management
        async function loadProducts(sid) {
            document.getElementById('productList').innerHTML = '<p class="text-center text-gray-400 py-8 text-sm">Loading products...</p>';
            try {
                const res = await fetch(`/field/api/stores/${sid}/products`);
                const data = await res.json();
                let html = '';
                if(data.products.length === 0) {
                    html = '<p class="text-center text-gray-400 py-8 text-sm">No products found for this store.</p>';
                } else {
                    data.products.forEach(p => {
                        html += `
                            <div onclick="openProductModal(${p.pid}, '${p.name.replace(/'/g,"\\'")}', ${p.price}, '${(p.description||'').replace(/'/g,"\\'")}', '${p.unit||''}', '${p.image||''}')" class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex gap-4 cursor-pointer hover:border-earthy transition-colors">
                                <div class="w-16 h-16 bg-gray-100 rounded-xl overflow-hidden flex-shrink-0">
                                    <img src="${p.image || 'https://dietalase.com/assets/images/default-product.png'}" class="w-full h-full object-cover">
                                </div>
                                <div class="flex-1 flex flex-col justify-center">
                                    <h4 class="font-bold text-sm text-earthy line-clamp-1">${p.name}</h4>
                                    <p class="text-xs font-bold text-orange-600 mt-1">Rp ${Number(p.price).toLocaleString()} <span class="text-gray-400 font-normal">/ ${p.unit||'item'}</span></p>
                                </div>
                            </div>
                        `;
                    });
                }
                document.getElementById('productList').innerHTML = html;
            } catch(e) {
                document.getElementById('productList').innerHTML = '<p class="text-center text-red-400 py-8 text-sm">Failed to load products.</p>';
            }
        }

        function openProductModal(pid = null, name = '', price = '', desc = '', unit = '', image = '') {
            document.getElementById('productModal').classList.remove('hidden');
            document.getElementById('productModal').classList.add('flex');
            
            // Slide up animation
            setTimeout(() => {
                document.getElementById('productModalContent').classList.remove('translate-y-full');
            }, 10);

            const form = document.getElementById('productForm');
            form.reset();

            if (pid) {
                document.getElementById('prodModalTitle').innerText = "Edit Product";
                document.getElementById('prod_pid').value = pid;
                document.getElementById('prod_name').value = name;
                document.getElementById('prod_price').value = price;
                document.getElementById('prod_desc').value = desc;
                document.getElementById('prod_unit').value = unit;
                document.getElementById('btnDeleteProd').classList.remove('hidden');
                
                document.getElementById('prod_image').removeAttribute('required');
                document.getElementById('prod_image_label').innerText = "Upload New Image (Optional)";
                if (image) {
                    document.getElementById('preview_prod_image').src = image;
                    document.getElementById('preview_prod_image').classList.remove('hidden');
                } else {
                    document.getElementById('preview_prod_image').classList.add('hidden');
                }
            } else {
                document.getElementById('prodModalTitle').innerText = "Add Product";
                document.getElementById('prod_pid').value = '';
                document.getElementById('btnDeleteProd').classList.add('hidden');
                
                document.getElementById('prod_image').setAttribute('required', 'true');
                document.getElementById('prod_image_label').innerText = "Product Photo (Camera) *";
                document.getElementById('preview_prod_image').classList.add('hidden');
            }
        }

        function closeProductModal() {
            document.getElementById('productModalContent').classList.add('translate-y-full');
            setTimeout(() => {
                document.getElementById('productModal').classList.add('hidden');
                document.getElementById('productModal').classList.remove('flex');
            }, 300); // match transition duration
        }

        async function submitProduct(e) {
            e.preventDefault();
            if(!currentStoreSid) return;

            const pid = document.getElementById('prod_pid').value;
            const formData = new FormData();
            formData.append('name', document.getElementById('prod_name').value);
            formData.append('price', document.getElementById('prod_price').value);
            formData.append('description', document.getElementById('prod_desc').value);
            formData.append('unit', document.getElementById('prod_unit').value);
            
            const imgFile = document.getElementById('prod_image').files[0];
            if (imgFile) formData.append('image', imgFile);

            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerText = "Saving..."; btn.disabled = true;

            try {
                const url = pid 
                    ? `/field/api/products/${pid}/update` 
                    : `/field/api/stores/${currentStoreSid}/products/add`;
                
                const res = await fetch(url, { method: 'POST', body: formData });
                const data = await res.json();
                
                if (data.success) {
                    closeProductModal();
                    loadProducts(currentStoreSid);
                } else {
                    showAlert("Failed: " + data.message);
                }
            } catch(e) { showAlert("Error connecting to server."); }
            
            btn.innerText = "Save Product"; btn.disabled = false;
        }

        async function deleteProduct() {
            const pid = document.getElementById('prod_pid').value;
            if(!pid || !(await showConfirm("Are you sure you want to delete this product?"))) return;

            const btn = document.getElementById('btnDeleteProd');
            btn.innerText = "..."; btn.disabled = true;

            try {
                const res = await fetch(`/field/api/products/${pid}/delete`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    closeProductModal();
                    loadProducts(currentStoreSid);
                } else {
                    showAlert("Failed to delete.");
                }
            } catch(e) { showAlert("Error connecting to server."); }
            
            btn.innerText = "Delete"; btn.disabled = false;
        }
    </script>
    <!-- Custom Alert Modal -->
    <div id="customAlertModal" class="fixed inset-0 bg-black/60 z-[9999] hidden items-center justify-center backdrop-blur-sm opacity-0 transition-opacity duration-300">
        <div class="bg-white p-8 rounded-3xl max-w-sm w-[90%] text-center shadow-2xl transform scale-95 transition-transform duration-300" id="customAlertContent">
            <div class="bg-orange-50 p-4 rounded-full inline-flex mb-4 text-earthy">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h2 id="customAlertTitle" class="font-bold text-xl text-earthy mb-2">Notification</h2>
            <p id="customAlertMessage" class="text-gray-500 text-sm mb-6 leading-relaxed"></p>
            <button onclick="closeCustomAlert()" class="w-full py-3 bg-earthy text-white font-bold rounded-xl hover:bg-[#4a2e19] transition-colors shadow-md">OK</button>
        </div>
    </div>
    <script>
        function showAlert(message, title = 'Notification') {
            document.getElementById('customAlertTitle').innerText = title;
            document.getElementById('customAlertMessage').innerText = message;
            const modal = document.getElementById('customAlertModal');
            const content = document.getElementById('customAlertContent');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            // trigger reflow
            void modal.offsetWidth;
            modal.classList.remove('opacity-0');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }
        function closeCustomAlert() {
            const modal = document.getElementById('customAlertModal');
            const content = document.getElementById('customAlertContent');
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 300);
        }

        function showConfirm(message, title = 'localhost:3000 says') {
            return new Promise((resolve) => {
                document.getElementById('customConfirmTitle').innerText = title;
                document.getElementById('customConfirmMessage').innerText = message;
                
                const modal = document.getElementById('customConfirmModal');
                const content = document.getElementById('customConfirmContent');
                
                const btnCancel = document.getElementById('customConfirmCancel');
                const btnOk = document.getElementById('customConfirmOk');
                
                const newBtnCancel = btnCancel.cloneNode(true);
                const newBtnOk = btnOk.cloneNode(true);
                btnCancel.replaceWith(newBtnCancel);
                btnOk.replaceWith(newBtnOk);
                
                function close() {
                    modal.classList.add('opacity-0');
                    content.classList.remove('scale-100');
                    content.classList.add('scale-95');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        modal.classList.remove('flex');
                    }, 300);
                }
                
                newBtnCancel.onclick = () => {
                    close();
                    resolve(false);
                };
                
                newBtnOk.onclick = () => {
                    close();
                    resolve(true);
                };
                
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                void modal.offsetWidth; // reflow
                modal.classList.remove('opacity-0');
                content.classList.remove('scale-95');
                content.classList.add('scale-100');
            });
        }
    </script>

    <!-- Custom Confirm Modal -->
    <div id="customConfirmModal" class="fixed inset-0 bg-black/60 z-[9999] hidden items-center justify-center backdrop-blur-sm opacity-0 transition-opacity duration-300">
        <div class="bg-white p-8 rounded-3xl max-w-sm w-[90%] text-center shadow-2xl transform scale-95 transition-transform duration-300" id="customConfirmContent">
            <div class="bg-red-50 p-4 rounded-full inline-flex mb-4 text-red-600">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <h2 id="customConfirmTitle" class="font-bold text-xl text-earthy mb-2">localhost:3000 says</h2>
            <p id="customConfirmMessage" class="text-gray-500 text-sm mb-6 leading-relaxed whitespace-pre-line"></p>
            <div class="flex gap-3">
                <button id="customConfirmCancel" class="w-full py-3 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 transition-colors shadow-sm">Cancel</button>
                <button id="customConfirmOk" class="w-full py-3 bg-red-600 text-white font-bold rounded-xl hover:bg-red-700 transition-colors shadow-md">OK</button>
            </div>
        </div>
    </div>
