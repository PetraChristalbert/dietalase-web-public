<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Field Admin - Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Outfit', 'sans-serif'] },
                    colors: { earthy: '#5C4033' }
                }
            }
        }
    </script>
</head>
<body class="bg-orange-50 h-screen flex flex-col justify-center items-center p-6">
    <div class="w-full max-w-sm bg-white rounded-3xl p-8 shadow-xl border border-orange-100">
        <div class="flex justify-center mb-6">
            <div class="w-16 h-16 bg-earthy text-white rounded-2xl flex items-center justify-center shadow-lg">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path></svg>
            </div>
        </div>
        <h1 class="text-2xl font-bold text-center text-earthy mb-2">Field Agent Portal</h1>
        <p class="text-sm text-center text-gray-500 mb-8">Login to manage local artisans</p>

        <% if (error) { %>
            <div class="mb-4 p-3 bg-red-50 text-red-600 rounded-xl text-sm font-medium border border-red-100">
                <%= error %>
            </div>
        <% } %>

        <form action="/field/login" method="POST" class="flex flex-col gap-4">
            <div>
                <label class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 block">Username</label>
                <input type="text" name="username" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-earthy text-sm">
            </div>
            <div>
                <label class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 block">Password</label>
                <input type="password" name="password" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-earthy text-sm">
            </div>
            <button type="submit" class="w-full mt-4 py-3 bg-earthy hover:bg-[#4a3328] text-white font-bold rounded-xl transition-all shadow-md">
                Secure Login
            </button>
        </form>
    </div>
</body>
</html>
