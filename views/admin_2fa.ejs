<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atelier Curator | Verifikasi 2FA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #0b0a0a; color: #f5f5f7; }
        .glass-card { background: rgba(18, 17, 17, 0.85); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(20px); }
        .glow-orange { box-shadow: 0 0 40px rgba(249, 115, 22, 0.1); }
        .code-input::-webkit-outer-spin-button,
        .code-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        .code-input { -moz-appearance: textfield; }
    </style>
</head>
<body class="h-screen flex items-center justify-center p-6 relative overflow-hidden">
    <!-- Starfield/Grid Background -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-neutral-900 via-black to-black z-0"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:24px_24px] z-0"></div>

    <div class="relative max-w-md w-full glass-card rounded-[40px] p-10 text-center z-10 glow-orange">
        <!-- Shield Secure Icon -->
        <div class="w-20 h-20 bg-orange-950/40 border border-orange-500/20 rounded-3xl flex items-center justify-center mx-auto mb-8 text-orange-500">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
        </div>

        <h1 class="text-3xl font-extrabold text-white tracking-tight">Verifikasi Dua Langkah</h1>
        <p class="text-neutral-400 mt-3 text-sm font-light leading-relaxed">
            Kode verifikasi OTP telah dikirimkan ke nomor WhatsApp Anda. Silakan masukkan 6 digit kode keamanan di bawah.
        </p>

        <% if (error) { %>
            <div class="mt-6 p-4 bg-red-950/40 border border-red-500/20 rounded-2xl flex items-center gap-3">
                <svg class="w-5 h-5 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                <p class="text-red-300 text-xs font-semibold text-left"><%= error %></p>
            </div>
        <% } %>

        <form action="/admin/verify-2fa" method="POST" class="mt-8 space-y-8">
            <!-- Hidden Single Input to hold the complete OTP -->
            <input type="hidden" name="otp_code" id="otp_code_hidden">

            <!-- 6 Boxes Digit Input -->
            <div class="flex justify-between gap-2 max-w-xs mx-auto" id="otp_boxes">
                <input type="number" pattern="[0-9]*" inputmode="numeric" max="9" min="0" class="code-input w-12 h-14 bg-neutral-950/80 border border-neutral-800 rounded-xl text-center text-xl font-bold text-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none transition-all" required>
                <input type="number" pattern="[0-9]*" inputmode="numeric" max="9" min="0" class="code-input w-12 h-14 bg-neutral-950/80 border border-neutral-800 rounded-xl text-center text-xl font-bold text-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none transition-all" required disabled>
                <input type="number" pattern="[0-9]*" inputmode="numeric" max="9" min="0" class="code-input w-12 h-14 bg-neutral-950/80 border border-neutral-800 rounded-xl text-center text-xl font-bold text-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none transition-all" required disabled>
                <input type="number" pattern="[0-9]*" inputmode="numeric" max="9" min="0" class="code-input w-12 h-14 bg-neutral-950/80 border border-neutral-800 rounded-xl text-center text-xl font-bold text-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none transition-all" required disabled>
                <input type="number" pattern="[0-9]*" inputmode="numeric" max="9" min="0" class="code-input w-12 h-14 bg-neutral-950/80 border border-neutral-800 rounded-xl text-center text-xl font-bold text-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none transition-all" required disabled>
                <input type="number" pattern="[0-9]*" inputmode="numeric" max="9" min="0" class="code-input w-12 h-14 bg-neutral-950/80 border border-neutral-800 rounded-xl text-center text-xl font-bold text-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none transition-all" required disabled>
            </div>

            <div class="text-xs text-neutral-500 font-medium">
                Kode berakhir dalam <span id="timerText" class="text-orange-500 font-bold">05:00</span>
            </div>

            <button type="submit" class="w-full bg-orange-600 hover:bg-orange-500 text-white py-4 rounded-2xl font-bold text-base shadow-lg shadow-orange-950/30 transition-all transform active:scale-[0.98] outline-none">
                Verifikasi & Masuk
            </button>
        </form>

        <p class="text-[11px] text-neutral-500 font-semibold tracking-wider uppercase mt-8 flex items-center justify-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
            Security Gate V2
        </p>
    </div>

    <script>
        const inputs = document.querySelectorAll('#otp_boxes input');
        const hiddenInput = document.getElementById('otp_code_hidden');
        const form = document.querySelector('form');

        // Focus Handlers
        inputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                const val = e.target.value;
                if (val.length > 1) {
                    e.target.value = val.slice(0, 1);
                }
                if (e.target.value !== '') {
                    if (index < inputs.length - 1) {
                        inputs[index + 1].removeAttribute('disabled');
                        inputs[index + 1].focus();
                    }
                }
                updateHiddenInput();
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && e.target.value === '') {
                    if (index > 0) {
                        inputs[index - 1].focus();
                        inputs[index].setAttribute('disabled', true);
                    }
                }
            });
        });

        // Paste support
        window.addEventListener('paste', (e) => {
            const pasteData = (e.clipboardData || window.clipboardData).getData('text');
            const digits = pasteData.replace(/\D/g, '').slice(0, 6);
            if (digits.length === 6) {
                inputs.forEach((input, idx) => {
                    input.removeAttribute('disabled');
                    input.value = digits[idx];
                    if (idx < inputs.length - 1) {
                        inputs[idx + 1].removeAttribute('disabled');
                    }
                });
                inputs[5].focus();
                updateHiddenInput();
            }
        });

        const updateHiddenInput = () => {
            let code = '';
            inputs.forEach(input => code += input.value);
            hiddenInput.value = code;
        };

        form.addEventListener('submit', (e) => {
            updateHiddenInput();
            if (hiddenInput.value.length !== 6) {
                e.preventDefault();
                alert('Silakan lengkapi 6 digit kode OTP.');
            }
        });

        // 5 Minutes Countdown
        let seconds = 300;
        const timerText = document.getElementById('timerText');
        const countInterval = setInterval(() => {
            if (seconds <= 0) {
                clearInterval(countInterval);
                location.href = '/admin/login';
                return;
            }
            seconds--;
            const mins = Math.floor(seconds / 60).toString().padStart(2, '0');
            const secs = (seconds % 60).toString().padStart(2, '0');
            timerText.textContent = `${mins}:${secs}`;
        }, 1000);
    </script>
</body>
</html>
