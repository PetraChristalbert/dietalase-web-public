      const HeroSection = () => {
        const [searchIndex, setSearchIndex] = useState(0);
        const [phase, setPhase] = useState("TYPING");
        const [displayText, setDisplayText] = useState("");
        const [isFilterOpen, setIsFilterOpen] = useState(false);
        const [shownIndex, setShownIndex] = useState(-1);

        useEffect(() => {
          let isActive = true;

          const runCycle = async () => {
            const currentKeyword = SEARCHES[searchIndex].keyword;

            setPhase("TYPING");
            setDisplayText("");
            const typeTime = 1500 / currentKeyword.length;
            for (let i = 1; i <= currentKeyword.length; i++) {
              if (!isActive) return;
              setDisplayText(currentKeyword.substring(0, i));
              await new Promise((r) => setTimeout(r, typeTime));
            }

            setPhase("SHOWING");
            setShownIndex(searchIndex);
            await new Promise((r) => setTimeout(r, 2850));

            setPhase("DELETING");
            const delTime = 650 / currentKeyword.length;
            for (let i = currentKeyword.length; i >= 0; i--) {
              if (!isActive) return;
              setDisplayText(currentKeyword.substring(0, i));
              await new Promise((r) => setTimeout(r, delTime));
            }

            if (isActive) {
              setSearchIndex((prev) => (prev + 1) % SEARCHES.length);
            }
          };

          runCycle();
          return () => {
            isActive = false;
          };
        }, [searchIndex]);

        const currentSearch = SEARCHES[searchIndex];

        return (
          <React.Fragment>
            {currentSearch.products.map((p, index) => {
              const blurPx = (p.distance / 15) * 3;
              const opVal = Math.max(0.4, 1 - (p.distance / 15) * 0.5);
              const isVisible = phase === "SHOWING";

              return (
                <div
                  key={p.id}
                  className={`absolute ${p.distance < 5 ? "z-30" : "z-10"} hidden md:block ${isVisible ? "hover:z-50" : ""}`}
                  style={{
                    left: p.left,
                    right: p.right,
                    top: p.top,
                    bottom: p.bottom,
                  }}
                >
                  <div
                    className={`diorama-item group transition-all duration-500 ${isVisible ? "cursor-pointer hover:!blur-none hover:!opacity-100 hover:-translate-y-2" : ""}`}
                    style={{
                      position: "relative",
                      transform: `scale(${p.scale})`,
                      filter: `blur(${blurPx}px)`,
                      opacity: opVal,
                    }}
                  >
                    <div
                      className={`diorama-card ${isVisible ? "animate-pop-in" : shownIndex === searchIndex ? "animate-pop-out" : "opacity-0"}`}
                      style={{
                        animationDelay: isVisible ? `${index * 0.3}s` : "0s",
                      }}
                    >
                      <div
                        className="diorama-card-img"
                        style={{ backgroundImage: `url('${p.img}')` }}
                      ></div>
                      <div className="diorama-card-info">
                        <h4>{p.title}</h4>
                        <span className="diorama-price">{p.price}</span>
                        <span className="diorama-distance">
                          {p.distance.toFixed(1)} km away
                        </span>
                      </div>
                    </div>
                    <div
                      className={`diorama-pin ${isVisible ? "animate-pin-grow" : shownIndex === searchIndex ? "animate-pin-shrink" : "opacity-0"}`}
                      style={{
                        animationDelay: isVisible ? `${index * 0.3}s` : "0s",
                      }}
                    ></div>
                    <div
                      className="diorama-shadow"
                      style={{
                        opacity: isVisible ? 1 : 0,
                        transition: "opacity 0.4s",
                      }}
                    ></div>
                  </div>
                </div>
              );
            })}

