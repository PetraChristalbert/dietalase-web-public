          <a href="#" class="text-sm hover:text-white text-[#ffe3d1]/80 transition text-decoration-none"><%= __('index_text_22') %></a>
          <a href="#" class="text-sm hover:text-white text-[#ffe3d1]/80 transition text-decoration-none"><%= __('index_text_12') %></a>
