    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Mobile & Desktop Menu Logic
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const desktopMenuBtn = document.getElementById('desktopMenuBtn');
        const mobileMenuGrid = document.getElementById('mobileMenuGrid');
        const mobileMenuLinks = document.getElementById('mobileMenuLinks');
        const mobileMenuIcon = document.getElementById('mobileMenuIcon');
        const desktopMenuIcon = document.getElementById('desktopMenuIcon');
        const mobileMenuBackdrop = document.getElementById('mobileMenuBackdrop');
        
        let isMobileMenuOpen = false;

        function closeMobileMenu() {
          isMobileMenuOpen = false;
          if (mobileMenuGrid) mobileMenuGrid.style.maxHeight = '0px';
          if (mobileMenuLinks) {
            mobileMenuLinks.classList.add('opacity-0');
            mobileMenuLinks.classList.remove('opacity-100');
          }
          if (mobileMenuIcon) mobileMenuIcon.style.transform = 'rotate(0deg)';
          if (desktopMenuIcon) desktopMenuIcon.style.transform = 'rotate(0deg)';
          if (mobileMenuBackdrop) {
            mobileMenuBackdrop.classList.add('opacity-0', 'pointer-events-none');
            mobileMenuBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
          }
        }

        function openMobileMenu() {
          isMobileMenuOpen = true;
          if (mobileMenuGrid) mobileMenuGrid.style.maxHeight = '500px';
          if (mobileMenuLinks) {
            mobileMenuLinks.classList.remove('opacity-0');
            mobileMenuLinks.classList.add('opacity-100');
          }
          if (mobileMenuIcon) mobileMenuIcon.style.transform = 'rotate(180deg)';
          if (desktopMenuIcon) desktopMenuIcon.style.transform = 'rotate(180deg)';
          if (mobileMenuBackdrop) {
            mobileMenuBackdrop.classList.remove('opacity-0', 'pointer-events-none');
            mobileMenuBackdrop.classList.add('opacity-100', 'pointer-events-auto');
          }
        }

        if (mobileMenuBtn) {
          mobileMenuBtn.addEventListener('click', (e) => {
            e.preventDefault();
            if (isMobileMenuOpen) {
              closeMobileMenu();
            } else {
              openMobileMenu();
            }
          });
        }
        
        if (desktopMenuBtn) {
          desktopMenuBtn.addEventListener('click', (e) => {
            e.preventDefault();
            if (isMobileMenuOpen) {
              closeMobileMenu();
            } else {
              openMobileMenu();
            }
          });
        }

        if (mobileMenuBackdrop) {
          mobileMenuBackdrop.addEventListener('click', closeMobileMenu);
        }

        // Status Quo Thoughts Logic
        const consumerThoughts = Array.from(
          document.querySelectorAll("#consumerThoughts .thought-text"),
        );
        const artisanThoughts = Array.from(
          document.querySelectorAll("#artisanThoughts .thought-text"),
        );

        let cIndex = 0;
        const yLevels = ["top", "mid", "bottom"];
        const yPositions = { top: "5%", mid: "35%", bottom: "65%" };

        const consumerState = {
          lastSide: "right",
          lastY: "mid",
          leftLastY: null,
          rightLastY: null,
          activeItems: [],
        };
        const artisanState = {
          lastSide: "left",
          lastY: "top",
          leftLastY: null,
          rightLastY: null,
          activeItems: [],
        };

        function spawnThought(thoughtsArray, indexToSpawn, state) {
          if (thoughtsArray.length === 0) return;
          const t = thoughtsArray[indexToSpawn];

          t.className = "thought-text"; // Reset classes

          const side = state.lastSide === "left" ? "right" : "left";
          state.lastSide = side;

          // Cannot match the opposite side's current active Y, AND cannot match this side's previous Y
          let availableY = yLevels.filter(
            (y) => y !== state.lastY && y !== state[`${side}LastY`],
          );

          // Fallback if empty (should never happen with 3 levels, but safe to have)
          if (availableY.length === 0)
            availableY = yLevels.filter((y) => y !== state.lastY);

          const yLvl =
            availableY[Math.floor(Math.random() * availableY.length)];
          state.lastY = yLvl;
          state[`${side}LastY`] = yLvl;

          t.style.top = yPositions[yLvl];
          t.style.bottom = "auto";

          if (side === "left") {
            t.style.left = "-5%";
            t.style.right = "auto";
            t.classList.add("bubble-left");
          } else {
            t.style.right = "-5%";
            t.style.left = "auto";
            t.classList.add("bubble-right");
          }
          t.classList.add(`bubble-${yLvl}`);

          requestAnimationFrame(() => {
            t.classList.add("active");
          });

          // Add to queue
          state.activeItems.push(t);

          // Failsafe & Mobile restriction
          const maxItems = window.innerWidth <= 1024 ? 1 : 2;
          if (state.activeItems.length > maxItems) {
            const old = state.activeItems.shift();
            old.classList.remove("active");
          }

          setTimeout(() => {
            t.classList.remove("active");
            // Clean up queue
            state.activeItems = state.activeItems.filter((item) => item !== t);
          }, 5000); // Wait 5 seconds to disappear
        }

        function triggerNextThoughts() {
          spawnThought(consumerThoughts, cIndex, consumerState);
          spawnThought(artisanThoughts, cIndex, artisanState);
          cIndex = (cIndex + 1) % consumerThoughts.length;
        }

        // Spawn first set immediately
        triggerNextThoughts();

        // Spawn next set every 2.5 seconds (half of 5s)
        let thoughtInterval = setInterval(triggerNextThoughts, 2500);

        // Catalyst Button Logic
        const catalystButton = document.getElementById("catalystButton");
        if (catalystButton) {
          catalystButton.addEventListener("click", () => {
            clearInterval(thoughtInterval);
            const allThoughts = document.querySelectorAll(".thought-text");
            allThoughts.forEach((t) => {
              t.classList.add("dissolve");
            });
            catalystButton.innerHTML =
              '<span style="color:#ffffff; font-size:2.5rem; font-weight:bold;">✓</span>';
            catalystButton.style.backgroundColor = "#4caf50";
            catalystButton.style.boxShadow = "0 0 20px rgba(76, 175, 80, 0.6)";

            // Optional: Scroll down to the center of the combined section automatically
            setTimeout(() => {
              document
                .getElementById("catalystSection")
                .scrollIntoView({ behavior: "smooth", block: "center" });
            }, 800);
          });
        }

        // Diorama Section Logic (Removed to display Map instead)
        const mapPins = document.querySelectorAll('.map-pin');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              mapPins.forEach((pin, index) => {
                setTimeout(() => {
                  pin.classList.remove('opacity-0', 'translate-y-6');
                  pin.classList.add('opacity-100', 'translate-y-0');
                }, index * 40);
              });
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });

        const mapStage = document.querySelector('.map-stage');
        if (mapStage && mapPins.length > 0) {
          observer.observe(mapStage);
        }

        // About Section Intro Animation Logic
        const aboutCardsContainer = document.querySelector('.about-cards-container');
        const aboutIntroCards = document.querySelectorAll('.about-intro-card');
        const aboutIntroImgs = document.querySelectorAll('.about-intro-img');
        
        const aboutObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              aboutIntroCards.forEach((card, index) => {
                setTimeout(() => {
                  card.classList.add('animate-in');
                  // Image slides out from behind the card after the card starts moving
                  setTimeout(() => {
                    if (aboutIntroImgs[index]) {
                      aboutIntroImgs[index].classList.add('animate-in');
                    }
                  }, 400); 
                }, index * 300);
              });
              aboutObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });

        if (aboutCardsContainer) {
          aboutObserver.observe(aboutCardsContainer);
        }
        // Language Selector Logic
        const langBtn = document.getElementById('languageSelectorBtn');
        const langPanel = document.getElementById('languageOptionsPanel');
        const langIcon = document.getElementById('languageSelectorIcon');
        let isLangOpen = false;

        if (langBtn) {
          langBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            isLangOpen = !isLangOpen;
            if (isLangOpen) {
              langPanel.style.maxHeight = '250px';
              langIcon.style.transform = 'rotate(180deg)';
            } else {
              langPanel.style.maxHeight = '0px';
              langIcon.style.transform = 'rotate(0deg)';
            }
          });

          // Close on outside click
          document.addEventListener('click', (e) => {
            if (isLangOpen && !document.getElementById('languageSelectorWrapper').contains(e.target)) {
              isLangOpen = false;
              langPanel.style.maxHeight = '0px';
              langIcon.style.transform = 'rotate(0deg)';
            }
          });
        }
      });
    </script>

    <!-- Language Selector Floating Widget -->
    <div id="languageSelectorWrapper" class="fixed bottom-0 left-4 md:left-8 z-50 w-[120px] rounded-t-xl overflow-hidden shadow-[0_-4px_20px_rgba(0,0,0,0.2)] bg-[#5c3a20] border border-[#4a2e19] border-b-0 pointer-events-auto">
      <!-- Expanding Drop-up Panel -->
      <div id="languageOptionsPanel" class="w-full bg-[#5c3a20] flex flex-col justify-end" style="max-height: 0px; transition: max-height 0.3s ease-in-out;">
        <div class="flex flex-col w-full text-sm font-medium text-[#ffe3d1]">
          <button onclick="window.location.href='/change-language/en?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search)" class="flex items-center gap-3 px-4 py-3 bg-[#6f4627] hover:bg-[#6f4627] transition-colors w-full text-left border-b border-[#4a2e19] outline-none cursor-pointer text-[#ffe3d1]">
            <span class="text-lg leading-none">🇬🇧</span>
            <span><%= __('index_text_141') %></span>
          </button>
          <button onclick="window.location.href='/change-language/id?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search)" class="flex items-center gap-3 px-4 py-3 bg-[#5c3a20] hover:bg-[#6f4627] transition-colors w-full text-left border-b border-[#4a2e19] outline-none cursor-pointer text-[#ffe3d1]">
            <span class="text-lg leading-none">🇮🇩</span>
            <span><%= __('index_text_142') %></span>
          </button>
          <button onclick="window.location.href='/change-language/jp?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search)" class="flex items-center gap-3 px-4 py-3 bg-[#5c3a20] hover:bg-[#6f4627] transition-colors w-full text-left border-b border-[#4a2e19] outline-none cursor-pointer text-[#ffe3d1]">
            <span class="text-lg leading-none">🇯🇵</span>
            <span><%= __('index_text_143') %></span>
          </button>
          <button onclick="window.location.href='/change-language/ph?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search)" class="flex items-center gap-3 px-4 py-3 bg-[#5c3a20] hover:bg-[#6f4627] transition-colors w-full text-left border-b border-[#4a2e19] outline-none cursor-pointer text-[#ffe3d1]">
            <span class="text-lg leading-none">🇵🇭</span>
            <span><%= __('index_text_144') %></span>
          </button>
        </div>
      </div>
      <!-- Trigger Button -->
      <%
        const loc = (typeof getLocale === 'function') ? getLocale() : 'en';
        const flagMap = { en: '🇬🇧', id: '🇮🇩', jp: '🇯🇵', ph: '🇵🇭' };
      %>
      <button id="languageSelectorBtn" class="flex items-center justify-between w-full bg-[#5c3a20] hover:bg-[#6f4627] transition-colors px-4 py-3 pointer-events-auto border-none outline-none cursor-pointer" style="color: #ffe3d1;">
        <div class="flex items-center gap-2 font-bold text-sm">
          <span class="text-lg leading-none"><%= flagMap[loc] || '🇬🇧' %></span>
          <span><%= loc.toUpperCase() %></span>
        </div>
        <svg id="languageSelectorIcon" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
      </button>
    </div>
    <style>
      .cs-modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(30, 27, 24, 0.6); z-index: 99999; display: none; align-items: center; justify-content: center; backdrop-filter: blur(4px); opacity: 0; transition: opacity 0.3s ease; }
      .cs-modal-overlay.active { display: flex; opacity: 1; }
      .cs-modal-content { background: white; padding: 32px 24px; border-radius: 20px; max-width: 400px; width: 90%; box-shadow: 0 10px 40px rgba(0,0,0,0.1); transform: translateY(20px); transition: transform 0.3s ease; text-align: center; }
      .cs-modal-overlay.active .cs-modal-content { transform: translateY(0); }
      .cs-btn-primary { padding: 12px 24px; border-radius: 12px; background: #6f4627; color: white; border: none; cursor: pointer; width: 100%; font-weight: 600; font-family: 'Outfit', sans-serif; font-size: 1rem; transition: background 0.2s; }
      .cs-btn-primary:hover { background: #5c3a20; }
    </style>
    <div class="cs-modal-overlay" id="coming-soon-modal">
      <div class="cs-modal-content">
        <div style="background: #fff3eb; padding: 20px; border-radius: 50%; display: inline-flex; margin-bottom: 20px;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6f4627" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12.01" y2="18"></line>
          </svg>
        </div>
        <h3 style="margin: 0 0 12px 0; font-size: 1.5rem; color: #1e1b18; font-family: 'Outfit', sans-serif; font-weight: 700;"><%= __('index_coming_soon_title') %></h3>
        <p style="color: #666; line-height: 1.6; margin: 0 0 24px 0; font-family: 'Inter', sans-serif; font-size: 0.95rem;">
          <%= __('index_coming_soon_desc') %>
        </p>
        <button class="cs-btn-primary" onclick="closeComingSoonModal()"><%= __('index_coming_soon_btn') %></button>
      </div>
    </div>
    <script>
      const csModal = document.getElementById('coming-soon-modal');
      window.openComingSoonModal = function(e) {
        if(e) e.preventDefault();
        csModal.style.display = 'flex';
        setTimeout(() => csModal.classList.add('active'), 10);
      }
      window.closeComingSoonModal = function() {
        csModal.classList.remove('active');
        setTimeout(() => csModal.style.display = 'none', 300);
      }
    </script>
  </body>
