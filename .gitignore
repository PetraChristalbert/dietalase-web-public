# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
combined.log
error.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/
.nyc_output

# Dependency directories
node_modules/

# Optional npm cache & repl
.npm
.eslintcache
.node_repl_history

# Output of 'npm pack'
*.tgz

# -------------------------------------------------------------------
# SECRETS AND SENSITIVE ASSETS (Ignored for Public Repository)
# -------------------------------------------------------------------
.env
.env.local
.env.*.local
service-account.json
secure_vault/gcs-backup-key.json
secure_vault/Owner_Ktp/*
!secure_vault/Owner_Ktp/.gitkeep

# Database backups & dump files
dietalase_backup.sql
backups/
tmp_restore/

# WhatsApp Web & Baileys session data
.wwebjs_auth/
auth_info_baileys/

# User uploaded storage (excluding sample assets)
tmp_uploads/*
!tmp_uploads/.gitkeep

# Office temporary lock files
~$*

# OS / Editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
.agent/
